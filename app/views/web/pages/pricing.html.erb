<div class="content">
  <div class="pricing-plans">
    <div class="wrap">
      <div class="price-head">
        <h1>Priced for you</h1>
        <% unless current_user %>
        <div class="price-lead price-lead-center">
          <p class="price-alt-lead mx-auto">VOYZ.ES is free to use for public projects<sup><i class="fa fa-asterisk asterisk"></i></sup>. Work&nbsp;together across private media documents with a paid&nbsp;plan.
          </p>
          <div class="border-behind">
            <span class="over-border"><a href="<%= new_user_registration_path %>" class="btn btn-large btn-primary btn-plan btn-plan-free">Join VOYZ.ES for free</a></span>
          </div>
        </div><!-- .price-lead -->
        <% end %>
      </div><!-- .price-head -->
      <%= render "web/shared/pricing_grid", show_details: true, show_highlight: true %>
      <div class="price-foot">
        <div class="price-lead price-lead-center">
          <div class="border-behind">
            <span class="over-border"><i class="fa fa-asterisk asterisk asterisk-over-border"></i></span>
          </div>
          <h3>Unlimited public media documents</h3>
          <p class="price-small-text mx-auto">Our free plan is currently limited to 10 minutes per media and comes with good transcription quality.</p>
          <p class="price-small-text mx-auto">For more questions check our <a href="<%= web_faqs_path %>">FAQs</a> or <%= mail_to("support@voyz.es", "contact us", subject: "Pricing questions") %>.</p>
        </div>
      </div><!-- .price-foot -->
    </div><!-- .wrap -->
  </div><!-- .pricing-plans -->
</div><!-- .content -->

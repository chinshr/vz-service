<div class="content">
  <div class="pricing-plans">
    <div class="wrap">
      <div class="price-head">
        <h1>Priced for you</h1>
        <% unless current_user %>
        <div class="price-lead price-lead-center">
          <p class="price-alt-lead mx-auto">VOYZ.ES is free for 30 minutes of public media with standard quality transcripts<sup><i class="fa fa-asterisk asterisk"></i></sup>
          </p>
          <div class="border-behind">
            <span class="over-border"><a href="<%= new_user_registration_path %>" class="button button-with-chrome button-plan button-plan-free">Join VOYZ.ES for free</a></span>
          </div>
        </div><!-- .price-lead -->
        <% end %>
      </div><!-- .price-head -->
      <%= render "web/shared/pricing_grid", show_details: true, show_highlight: true %>
      <div class="price-foot">
        <div class="price-lead price-lead-center">
          <div class="border-behind">
            <span class="over-border"><i class="fa fa-asterisk asterisk asterisk-over-border"></i></span>
          </div>
          <h3>Public media documents</h3>
          <p class="price-text price-medium-text mx-auto">Upgrade your plan for better quality transcripts, more processed minutes, private storage and team collaboration options.</p>
          <p class="price-text price-medium-text mx-auto">For more questions check our <a href="<%= web_faqs_path %>">Help</a> or <%= mail_to("support@voyz.es", "Contact us", subject: "Pricing questions") %>.</p>
        </div>
      </div><!-- .price-foot -->
    </div><!-- .wrap -->
  </div><!-- .pricing-plans -->
</div><!-- .content -->

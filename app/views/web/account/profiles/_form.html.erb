<% content_for :navbar_tag do %>
<a class="navbar-tag" href="/dashboard">Account</a>
<% end %>

<h1 class="page-header">User Profile</h1>

<%= form_for(current_user, {as: :user, url: web_account_profile_path, validate: true, remote: true, html: {method: :put, class: "form-horizontal", role: "form"}}) do |f| %>
  <%= render "web/shared/flash", remote: true, on: "#edit_user" %>
  <div class="form-group">
    <div class="input-group avatar-picker col-sm-4 col-md-2">
      <%= image_tag(avatar_url(current_user, {size: 96}), class: "avatar", style: "background-color: #{current_user.css_hex_color}; border-color: #{current_user.css_hex_color};") %>
      <div><a href="//gravatar.com/emails/" target="_blank" class="btn btn-change-avatar">Change Avatar</a></div>
    </div>

    <div class="input-group color-picker col-sm-4 col-md-2">
      <%= f.text_field :css_hex_color, :class => "form-control", value: current_user.css_hex_color %>
      <span class="input-group-addon"><i></i></span>
      <%= content_for :javascript_includes do %>
        <%= javascript_tag do %>
          $(function(){
            $('.color-picker').colorpicker();
          }).on('changeColor.colorpicker', function(event) {
            $(".avatar").attr("style", "background-color: " + event.color.toHex() + "; border-color: " + event.color.toHex() + ";");
          });
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :first_name %>
    <%= f.text_field :first_name, :class => "form-control", :placeholder => "Enter first name" %>
  </div>

  <div class="form-group">
    <%= f.label :last_name %>
    <%= f.text_field :last_name, :class => "form-control", :placeholder => "Enter last name" %>
  </div>

  <div class="form-group">
    <%= f.label :initials %>
    <div class="input-group col-sm-2 col-md-1">
      <%= f.text_field :initials, :class => "form-control", value: current_user.initials, maxlength: 2 %>
    </div>
  </div>

  <h2 class="sub-header">Region</h2>

  <div class="form-group">
    <%= f.label :time_zone %>
    <%#= f.time_zone_select :time_zone, ActiveSupport::TimeZone.all.sort, {model: ActiveSupport::TimeZone}, {class: "form-control"} %>
    <%= f.select :time_zone, ActiveSupport::TimeZone.all.sort_by {|tz| tz.to_s}.map {|tz| [tz.to_s, tz.tzinfo.identifier]}, {}, {class: "form-control"} %>
  </div>

  <div class="form-group action">
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </div>
<% end %>

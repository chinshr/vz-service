<%# http://getbootstrap.com/examples/dashboard/ %>
<div id="split-view" class="row">
  <div class="col-sm-4 col-md-3 sidebar">
    <ul class="nav nav-sidebar xnav-pills nav-stacked">
      <li class="<%= dom_active_class(Web::Account::DashboardsController) %>">
        <a href="<%= web_dashboard_path %>">
          <i class="glyphicon glyphicon-dashboard icon"></i>
          <span>Dashboard</span>
          <b class="glyphicon glyphicon-chevron-right chevron"></b>
        </a>
      </li>

      <li class="<%= dom_active_class(Web::Account::ProfilesController) %>">
        <a href="<%= web_account_profile_path %>">
          <i class="glyphicon glyphicon-user icon"></i>
          <span>User Profile</span>
          <b class="glyphicon glyphicon-chevron-right chevron"></b>
        </a>
      </li>

      <li class="<%= dom_active_class(Web::Account::SettingsController) %>">
        <a href="<%= web_account_settings_path %>">
          <i class="glyphicon glyphicon-cog icon"></i>
          <span>Account Settings</span>
          <b class="glyphicon glyphicon-chevron-right chevron"></b>
        </a>
      </li>

      <li class="<%= dom_active_class(Web::Account::BillingsController) %>">
        <a href="<%= web_account_billing_path %>">
          <i class="glyphicon glyphicon-usd icon"></i>
          <span>Billing Information</span>
          <b class="glyphicon glyphicon-chevron-right chevron"></b>
          <!-- <span class="badge pull-right"><%= 3 %></span> --> 
        </a>
      </li>
    </ul>
  </div>
  <div class="col-sm-8 col-sm-offset-4 col-md-9 col-md-offset-3 main">
    <div class="xclearfix"></div>
    <%= yield %>
  </div>
</div>
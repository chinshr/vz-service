<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12 full-width">
      
      <div class="blankstate blankstate-plain blankstate-welcome blankstate-secondary animated fade-in-down">
        <button type="button" class="close" data-dismiss="alert">×</button>
        
        <h1 class="thin light">Welcome to Record Your Life</h1>
        <p>Your account has been created successfully! <br>Take a look at these resources to help you get started.</p>
        <a class="icon-close blankstate-close" ng-click="hideWelcomeBanner()"></a>

        <ul class="list-inline">
          <li>
            <a class="btn btn-large btn-flat-plain" href="#"><i class="glyphicon glyphicon-headphones"></i>&nbsp;&nbsp;Tutorial</a>
          </li>

          <li>
            <a class="btn btn-large btn-flat-plain" href="#"><i class="glyphicon glyphicon-wrench"></i>&nbsp;&nbsp;Quickstart</a>
          </li>

          <li>
            <a class="btn btn-large btn-flat-plain" href="#"><i class="glyphicon glyphicon-heart-empty"></i>&nbsp;&nbsp;Examples</a>
          </li>

          <li>
            <a class="btn btn-large btn-flat-plain" href="#"><i class="glyphicon glyphicon-cutlery"></i>&nbsp;&nbsp;API Docs</a>
          </li>
        </ul>
      </div>
      
      <div class="alert alert-warning">
        <button type="button" class="close" data-dismiss="alert">×</button>
        This is is the image.
      </div>
    </div>
  </div>
  
  <div id="file-uploads" class="upload-grid">
    
    <div class="col-lg-4 col-md-4 col-sm-4">
      <div id="drop-box" class="panel panel-upload">
        <div class="panel-heading">
          <h4>Drop files here...</h4>
          <div class="word-separator">&mdash; or &mdash;</div>

          <!-- file picker -->
          <div class="form-group group-pick-file">
            <label for="" class="control-label hidden">Add file</label>
            <button class="btn btn-primary btn-file-upload">Add file...</button>
          </div>
          
        </div>
        <div class="panel-body">

          <form class="xform-horizontal" role="form">
            
            <!-- file privacy -->
            <div class="btn-group group-file-privacy" data-toggle="buttons">
              <label class="btn btn-primary active">
                <input type="radio" name="file-privacy" id="file-privacy-public"><i class="glyphicon glyphicon-book"></i>&nbsp;Public
              </label>
              <label class="btn btn-primary disabled">
                <input type="radio" name="file-privacy" id="file-privacy-private"><i class="glyphicon glyphicon-lock"></i>&nbsp;Private
              </label>
            </div>
            
          </form>
          
        </div><!-- panel-body -->
        <div class="panel-footer">
          <!-- file locale -->
          <div class="form-group group-file-locale">
            <label class="hidden" for="disabledSelect">Audio language</label>
            <select data-placeholder="Choose a Language..." id="file-locale" class="form-control locale-control">
              <option value=""></option>
              <option value="en-US">English United States</option>
              <option value="en-UK">English Great Britain</option>
              <option value="de-DE">German Germany</option>
              <option value="fr-FR">French France</option>
              <option value="it-IT">Italian Italy</option>
              <option value="es-ES">Spanish Spain</option>
              <option value="es-MX">Spanish Mexico</option>
              <option value="es-AR">Spanish Argentina</option>
              <option value="es-VE">Spanish Venezuela</option>
            </select>
          </div>
        </div>
        
      </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-4">
      <div class="panel panel-edit">
        <div class="progress progress-striped active">
          <div class="progress-bar progress-bar-info" style="width: 50%"></div>
        </div>
        <div class="panel-heading">
          i-like-pickles.wav
        </div>
        <div class="panel-body">
          Edit Body
        </div>
        <div class="panel-footer">
          Panel footer
        </div>
      </div>
    </div>
  
    <div class="col-lg-4 col-md-4 col-sm-4">
      <div class="panel panel-show">
        <div class="progress progress-striped active">
          <div class="progress-bar progress-bar-success" style="width: 75%"></div>
        </div>
        <div class="panel-heading">
          Show Panel
        </div>
        <div class="panel-body">
          Show Body
        </div>
        <div class="panel-footer">
          Panel footer
        </div>
      </div>
    </div>

  </div>
  

</div>




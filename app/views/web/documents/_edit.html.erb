<div class="document-overlay row">
  <div class="col-lg-1 col-md-1 col-sm-2 hidden-xs gutter">
    <% if false -%>
    <div class="note-head user-initials" id="<%= current_user.id %>" title="<%= current_user.name %>" data-bucket-number="0" style="opacity: 0; border-color: <%= current_user.css_hex_color %>; background-color: <%= current_user.css_hex_color %>; background-image: url(<%= avatar_url(current_user) %>);"><%= current_user.initials %></div>
    <% end -%>
  </div><!-- .gutter -->
  <div id="document-container" class="col-lg-11 col-md-11 col-sm-10 col-xs-12 document-container">
    <!-- backbone template -->
  </div><!-- #document-container .document-container -->
</div><!-- .document-overlay -->
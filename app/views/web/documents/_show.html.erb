<div class="document-overlay row">
  <div class="col-md-1 gutter">
  </div><!-- .gutter -->
  <div class="document-container col-md-10">
    <div class="title-container title-viewer-container">
      <h1><div id="title-viewer" class="viewer"><%= @document.title %></div></h1>
    </div><!-- .title-container .title-viewer-container -->
    <div class="content-container content-viewer-container">
      <div id="content-viewer" class="content-holder viewer">
        <%= raw(@document.html) %>
      </div>
    </div><!-- .content-editor-container -->
  </div><!-- .document-container -->
</div><!-- .document-overlay -->
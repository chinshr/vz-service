<div id="document-loading" class="document-loading-overlay row">
  <div id="document-load-error" class="message-container" style="display: none">
    <p>Sorry, we were unable to load your document.</p>
    <p class="reason">Please try again later.</p>
  </div><!-- #initial-load-error -->

  <div id="document-corruption-error" class="message-container" style="display: none">
    <p>Sorry, the document cannot be loaded.</p>
    <p class="reason">Please contact our support.</p>
  </div>

  <div id="document-not-ready-error" class="message-container" style="display: none">
    <p>It's great to see you, but you are a bit early.</p>
    <p class="reason">Your audio is being processed and hasn't finished transcribing, so check back later!</p>
  </div>

  <div id="loading" class="message-container">
    <p title="Loading...">Loading...</p>
  </div>
  <noscript>&lt;strong&gt;Sorry, you have to enable JavaScript in order to use this.&lt;/strong&gt;</noscript>
</div><!-- #document-loading .document-loading-overlay -->

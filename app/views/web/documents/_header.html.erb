<header class="documents">
  <div class="container-fluid">
    <nav class="navbar navbar-default" id="navigation" role="navigation">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        <div class="dropdown dropdown-toggle">
          <button id="dropdownMenu1" class="dropdown-toggle" data-toggle="dropdown">
            <a id="logo" class="navbar-brand">VOYZ.ES</a>
            <span class="caret"></span>
          </button>
          <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu1">
            <li role="presentation"><a role="menuitem" href="#"><i class="glyphicon glyphicon-dashboard"></i>Dashboard</a></li>
          </ul>
        </div>
      </div><!-- navbar-header -->
      
      <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
        <ul id="content-editor-toolbar-container" class="nav navbar-nav toolbar-nav">
          <!-- font-style -->
          <li><button title="Bold" type="button" class="btn btn-md btn-tlb ql-bold fa fa-bold"></button></li>
          <li><button title="Italic" type="button" class="btn btn-md btn-tlb ql-italic fa fa-italic"></button></li>
          <li><button title="Underline" type="button" class="btn btn-md btn-tlb ql-underline fa fa-underline"></button></li>
          <li><button title="Strike" type="button" class="btn btn-md btn-tlb ql-strike fa fa-strikethrough"></button></li>

          <li class="separator">&nbsp;</li>
          
          <!-- text-align -->
          <li><button title="Align Left" type="button" data-value="left" class="btn btn-md btn-tlb ql-align fa fa-align-left"></button></li>
          <li><button title="Align Center" type="button" data-value="center" class="btn btn-md btn-tlb ql-align-center fa fa-align-center"></button></li>
          <li><button title="Align Right" type="button" data-value="right" class="btn btn-md btn-tlb ql-align-right fa fa-align-right"></button></li>

          <li class="separator">&nbsp;</li>
          
          <!-- lists -->
          <li><button title="Numbered List" type="button" class="btn btn-md btn-tlb ql-list fa fa-list-ol"></button></li>
          <li><button title="Bulleted List" type="button" class="btn btn-md btn-tlb ql-bullet fa fa-list-ul"></button></li>
        </ul>
        
        <ul id="media-player-toolbar-container" class="nav navbar-nav toolbar-nav audio-player-nav">
          <!-- player -->
          <li><button title="Play" type="button" class="btn btn-md btn-tlb fa fa-play player player-play-pause" data-action="toggle-play-pause"></button></li>
          <li class="waveform-item">
            <div id="waveform" class="waveform-container">
              <div class="progress progress-striped active" id="player-progress-bar">
                  <div class="progress-bar progress-bar-info"></div>
              </div>
              <!-- Here goes the waveform -->
            </div>
          </li>
          <li><button title="Playback Speed" type="button" class="btn btn-lg btn-tlb fa fa-angle-double-up player player-toggle-playback-rate" data-action="toggle-playback-rate"></button></li>
          <li><button title="Step Backward" type="button" class="btn btn-sm btn-tlb fa fa-step-backward player player-step-backward" data-action="step-backward"></button></li>
          <li><button title="Step Forward" type="button" class="btn btn-sm btn-tlb fa fa-step-forward player player-step-forward" data-action="step-forward"></button></li>
          <li><button title="Reset" type="button" class="btn btn-md btn-tlb glyphicon glyphicon-repeat player player-reset" data-action="reset"></button></li>
        </ul>
      </div><!-- collapse navbar-collapse -->
    </nav>
  </div><!-- end container -->
</header><!-- documents -->


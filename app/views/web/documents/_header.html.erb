<header>
  <div class="container-fluid topbar-primary">
    <nav class="navbar navbar-default" id="navigation" role="navigation">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        <div class="dropdown xdropdown-toggle">
          <button id="dropdownMenu1" class="dropdown-toggle" type="button" data-toggle="dropdown">
            <a id="logo" class="navbar-brand">VOYZ.ES</a>
            <span class="caret"></span>
          </button>
          <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu1">
            <li role="presentation"><a role="menuitem" href="/dashboard"><i class="fa fa-level-up"></i>Dashboard</a></li>
            <% if (show? || edit?) && (policy(@document).edit? || policy(@document).show?) %>
            <li class="divider"></li>
            <% end %>
            <% if show? && policy(@document).edit? %>
            <li role="presentation"><a role="menuitem" href="<%= edit_web_document_path(@document.slug_id) %>"><i class="glyphicon glyphicon-pencil"></i>Edit</a></li>
            <% end %>
            <% if edit? && policy(@document).show? %>
            <li role="presentation"><a role="menuitem" href="<%= web_document_path(@document.slug_id) %>"><i class="glyphicon glyphicon-eye-open"></i>Preview</a></li>
            <% end %>
          </ul>
        </div>
      </div><!-- .navbar-header -->

      <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
        <!-- player -->
        <ul id="media-player-toolbar-container" class="nav navbar-nav toolbar-nav audio-player-nav">
          <li><button title="<%= key_cmd(:play, 'Esc') %>" type="button" class="btn btn-lg btn-tlb fa fa-play fa-fw player player-play-pause" data-action="toggle-play-pause" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button type="button" class="btn btn-lg btn-tlb btn-elt"><p id="elt">00:00.0</p></button></li>
          <li><button type="button" class="btn btn-lg btn-tlb btn-ttp"><p id="ttp">-00:00.0</p></button></li>
          <li><button title="<%= key_cmd(:step_backward, "F1") %>" type="button" class="btn btn-md btn-tlb fa fa-backward fa-fw player player-step-backward" data-action="step-backward" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:step_forward, "F2") %>" type="button" class="btn btn-md btn-tlb fa fa-forward fa-fw player player-step-forward" data-action="step-forward" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li>
            <button type="button" id="playback-speed-btn" class="btn btn-lg btn-tlb btn-speed player dropdown-toggle" data-toggle="dropdown"><p>1×</p></button>
            <ul id="playback-speed-menu" class="dropdown-menu">
              <li>
                <ul class="toolbar-nav sub-toolbar-nav">
                  <li><button title="<%= key_cmd(:slower, "F3") %>" type="button" class="btn btn-md btn-tlb fa fa-angle-down fa-fw player player-step-backward" data-action="playback-rate-down" data-toggle="tooltip" data-placement="left"></button></li>
                  <li class="slider-container"><input id="playback-speed-slider" class="playback-speed-slider"/></li>
                  <li><button title="<%= key_cmd(:faster, "F4") %>" type="button" class="btn btn-md btn-tlb fa fa-angle-up fa-fw player player-step-backward" data-action="playback-rate-up" data-toggle="tooltip" data-placement="right"></button></li>
                </ul>
              </li>
            </ul>
          </li>
          <li><button title="<%= key_cmd(:reset, 'Esc', [:shift_key]) %>" type="button" class="btn btn-md btn-tlb fa fa-stop fa-fw player player-reset" data-action="reset" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li class="separator">&nbsp;</li>
          <li><button title="<%= key_cmd(:mute) %>" type="button" class="btn btn-md btn-tlb fa fa-volume-off fa-fw player player-mute-toggle" data-action="toggle-mute" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:resize) %>" type="button" class="btn btn-md btn-tlb fa <%= waveform_visible? ? 'fa-compress' : 'fa-expand' %> fa-fw player player-resize-toggle" data-action="toggle-resize" data-toggle="tooltip" data-placement="bottom"></button></li>
        </ul>
        <!-- /player -->

        <% if edit? %>
        <!-- format -->
        <ul class="nav navbar-nav toolbar-nav content-editor-toolbar-container">
          <!-- font-style -->
          <li><button title="<%= key_cmd(:bold, 'B', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-bold fa fa-bold fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:italic, 'I', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-italic fa fa-italic fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:underline, 'U', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-underline fa fa-underline fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:strikethrough, 'S', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-strike fa fa-strikethrough fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li class="separator">&nbsp;</li>

          <!-- text-align -->
          <li><button title="<%= key_cmd(:align_left) %>" type="button" data-value="left" class="btn btn-md btn-tlb ql-align fa fa-align-left fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:align_center) %>" type="button" data-value="center" class="btn btn-md btn-tlb ql-align-center fa fa-align-center fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:align_right) %>" type="button" data-value="right" class="btn btn-md btn-tlb ql-align-right fa fa-align-right fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:align_justify) %>" type="button" data-value="right" class="btn btn-md btn-tlb ql-align-justify fa fa-align-justify fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li class="separator">&nbsp;</li>

          <!-- lists -->
          <li><button title="<%= key_cmd(:numbered_list) %>" type="button" class="btn btn-md btn-tlb ql-list fa fa-list-ol fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:bulleted_list) %>" type="button" class="btn btn-md btn-tlb ql-bullet fa fa-list-ul fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>
        </ul>
        <!-- /format popover -->
        <% end %>

        <% if show? %>
        <!-- share-popover -->
        <ul class="nav navbar-nav toolbar-nav content-viewer-toolbar-container">
          <!-- highlight -->
          <li><button title="<%= key_cmd(:highlight, 'H', :ctrl_key) %>" type="button" class="btn btn-md btn-tlb ql-bold fa fa-bookmark fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li class="separator">&nbsp;</li>

          <!-- share -->

          <li><button type="button" class="btn btn-md btn-tlb fa fa-facebook fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li><button type="button" class="btn btn-md btn-tlb fa fa-twitter fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li><button type="button" class="btn btn-md btn-tlb fa fa-linkedin fa-fw" data-toggle="tooltip" data-placement="bottom"></button></li>

        </ul>
        <!-- /share-popover -->
        <% end %>

        <!-- context menu -->
        <ul class="nav navbar-nav toolbar-nav pull-right">
          <li><!-- publish-->
            <button title="Publish" id="publish-button" class="btn btn-md btn-tlb btn-popover btn-publish fa fa-rocket" type="button" data-toggle="tooltip popover" data-placement="bottom" data-target="publish-popover"></button>

            <div id="publish-popover" class="popover fade bottom in" role="tooltip">
              <div class="popover-content">

                <div style="xdisplay:none;" id="publish-popover-publishing-page">
                  <div class="popover-heading">
                    <p>Do you want to publish your changes?</p>
                  </div>
                  <div class="popover-body">
                    <ul class="privacy-options">
                      <li><button class="btn btn-link btn-options btn-privacy" data-action="show-privacy-popover">Visibility: <%= @document.privacy.join.humanize %></button></li>
                      <% if false %>
                      <li><button class="btn btn-link btn-options btn-license" data-action="show-license-popover">License: All rights reserved</button></li>
                      <% end %>
                    </ul>
                  </div><!-- .popover-body -->
                  <div class="popover-footer">
                    <button class="btn btn-md btn-success btn-publish" type="submit" data-loading-text="Updating...">Publish Changes</button>
                  </div>
                </div><!-- #publish-popover-publishing-page -->

                <div style="display:none;" id="publish-popover-privacy-page">
                  <div class="popover-heading">
                    <p>Publishing visibility?</p>
                    <div class="form-group from-group-privacy clearfix">
                      <div class="btn-group group-privacy pull-left" data-toggle="buttons">
                        <label class="btn btn-primary btn-sm active">
                          <input type="radio" name="document[privacy]" id="document-privacy-public" value="public" checked=""><i class="fa fa-book icon-public"></i>&nbsp;Public
                        </label>
                        <label class="btn btn-primary btn-sm">
                          <input type="radio" name="document[privacy]" id="document-privacy-unlisted" value="unlisted" checked=""><i class="fa fa-eye-slash icon-unlisted"></i>&nbsp;Unlisted
                        </label>
                        <label class="btn btn-primary btn-sm">
                          <input type="radio" name="document[privacy]" id="document-privacy-private" value="private"><i class="fa fa-lock icon-private"></i>&nbsp;Private
                        </label>
                      </div><!-- .btn-group .group-file-privacy -->
                    </div><!-- .form-group .from-group-file-privacy -->
                  </div>

                  <div class="popover-body">
                    <p id="privacy-help-public" class="privacy-help">The document will be public. Your followers will be notified when you publish for the first time.</p>

                    <p style="display:none;" id="privacy-help-unlisted" class="privacy-help">The document will only be visible to those with the link. It won't be listed on VOYZ.ES's public pages.</p>

                    <p style="display:none;" id="privacy-help-private" class="privacy-help">The document will be private. Only you can view or edit the document.</p>
                  </div><!-- .popover-body -->

                  <div class="popover-footer">
                    <button class="btn btn-sm btn-success btn-submit" type="submit" data-loading-text="Updating...">Update</button>
                    <button class="btn btn-sm btn-link btn-cancel" type="cancel">Cancel</button>
                  </div><!-- .popover-footer -->
                </div><!-- #publish-popover-privacy-page -->
              </div><!-- .popover-content -->
            </div><!-- #share-popover .popover -->
          </li><!-- /publish -->

          <li class="separator">&nbsp;</li>

          <li><!-- share -->
            <button title="Share" id="share-button" class="btn btn-md btn-tlb btn-popover btn-share fa fa-share" type="button" data-toggle="popover tooltip" data-placement="bottom" data-target="share-popover"></button>

            <div id="share-popover" class="popover fade bottom in" role="tooltip">
              <!-- <h3 class="popover-title">Share!</h3> -->
              <div class="popover-content">
                <div class="social-container">
                  <ul class="nav navbar-nav toolbar-nav social-networks">
                    <li class="facebook"><button class="btn btn-md btn-tlb fa fa-facebook fa-fw" href="#" data-href=""></button></li>
                    <li class="twitter"><button class="btn btn-md btn-tlb fa fa-twitter fa-fw" href="#" data-href="" ></button></li>
                    <li class="linkedin"><button class="btn btn-md btn-tlb fa fa-linkedin fa-fw" href="#" data-href=""></button></li>
                    <!--<li class="email"><button class="btn btn-md btn-tlb fa fa-envelope fa-fw" href="#" data-href=""></button></li>-->
                  </ul><!-- .social-networks -->
                </div><!-- .social-container -->
                <div class="share-link-container">
                  <% if @document.privacy_private? %>
                  <p><i class="fa fa-lock"></i>This document is private and may only be viewed by the owner.</p>
                  <% else %>
                  <p><i class="fa fa-info"></i>Copy and paste the link below to share this document.</p>
                  <% end %>
                  <input type="url" class="width-full" readonly="readonly" value="<%= web_document_url(@document.slug) %>">
                </div>
              </div><!-- popover-content -->
            </div><!-- #share-popover .popover -->
          </li><!-- /share -->

        </ul>
        <!-- /context menu -->
      </div><!-- .collapse .navbar-collapse -->
    </nav>
  </div><!-- .container-fluid -->

  <div class="container-fluid topbar-secondary">
    <div id="wavebar" class="wavebar">
      <div id="waveform-timeline" class="waveform-timeline-container"></div>
      <div id="waveform" class="waveform-container">
        <div class="progress progress-striped active" id="player-progress-bar">
          <div class="progress-bar progress-bar-info"></div>
        </div>
        <!-- here goes the waveform -->
      </div>
    </div>
  </div><!-- .container-fluid .topbar-secondary -->
</header><!-- header -->

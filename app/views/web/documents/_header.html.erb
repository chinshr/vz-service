<header>
  <div class="container-fluid">
    <nav class="navbar navbar-default" id="navigation" role="navigation">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        <div class="dropdown xdropdown-toggle">
          <button id="dropdownMenu1" class="dropdown-toggle" type="button" data-toggle="dropdown">
            <a id="logo" class="navbar-brand">VOYZ.ES</a>
            <span class="caret"></span>
          </button>
          <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu">
            <li role="presentation"><a role="menuitem" href="/dashboard"><i class="fa fa-level-up"></i>Dashboard</a></li>
            <% if (show? || edit?) && (policy(@document).edit? || policy(@document).show?) %>
            <li class="divider"></li>
            <% end %>
            <% if show? && policy(@document).edit? %>
            <li role="presentation"><a role="menuitem" href="<%= edit_web_document_path(@document.slug) %>"><i class="glyphicon glyphicon-pencil"></i>Edit</a></li>
            <% end %>
            <% if edit? && policy(@document).show? %>
            <li role="presentation"><a role="menuitem" href="<%= web_document_path(@document.slug) %>"><i class="glyphicon glyphicon-eye-open"></i>Preview</a></li>
            <% end %>
          </ul>
        </div>
      </div><!-- .navbar-header -->

      <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
        <% if edit? %>
        <ul id="content-editor-toolbar-container" class="nav navbar-nav toolbar-nav">
          <!-- font-style -->
          <li><button title="<%= key_cmd(:bold, 'B', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-bold fa fa-bold" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:italic, 'I', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-italic fa fa-italic" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:underline, 'U', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-underline fa fa-underline" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:strikethrough, 'S', :meta_key) %>" type="button" class="btn btn-md btn-tlb ql-strike fa fa-strikethrough" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li class="separator">&nbsp;</li>

          <!-- text-align -->
          <li><button title="<%= key_cmd(:align_left) %>" type="button" data-value="left" class="btn btn-md btn-tlb ql-align fa fa-align-left" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:align_center) %>" type="button" data-value="center" class="btn btn-md btn-tlb ql-align-center fa fa-align-center" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:align_right) %>" type="button" data-value="right" class="btn btn-md btn-tlb ql-align-right fa fa-align-right" data-toggle="tooltip" data-placement="bottom"></button></li>

          <li class="separator">&nbsp;</li>

          <!-- lists -->
          <li><button title="<%= key_cmd(:numbered_list) %>" type="button" class="btn btn-md btn-tlb ql-list fa fa-list-ol" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:bulleted_list) %>" type="button" class="btn btn-md btn-tlb ql-bullet fa fa-list-ul" data-toggle="tooltip" data-placement="bottom"></button></li>
        </ul>
        <% end %>

        <ul id="media-player-toolbar-container" class="nav navbar-nav toolbar-nav audio-player-nav">
          <!-- player -->
          <li><button title="<%= key_cmd(:play, 'Space', [:shift_key, :meta_key]) %>" type="button" class="btn btn-lg btn-tlb fa fa-play player player-play-pause" data-action="toggle-play-pause" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li class="waveform-item">
            <div id="waveform" class="waveform-container">
              <div class="progress progress-striped active" id="player-progress-bar">
                  <div class="progress-bar progress-bar-info"></div>
              </div>
              <!-- here goes the waveform -->
            </div>
          </li>
          <li><button title="<%= key_cmd(:toggle_playback_speed) %>" type="button" class="btn btn-lg btn-tlb fa fa-angle-double-up player player-toggle-playback-rate" data-action="toggle-playback-rate" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:step_backward) %>" type="button" class="btn btn-md btn-tlb fa fa-step-backward player player-step-backward" data-action="step-backward" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:step_forward) %>" type="button" class="btn btn-md btn-tlb fa fa-step-forward player player-step-forward" data-action="step-forward" data-toggle="tooltip" data-placement="bottom"></button></li>
          <li><button title="<%= key_cmd(:stop) %>" type="button" class="btn btn-md btn-tlb fa fa-stop player player-reset" data-action="reset" data-toggle="tooltip" data-placement="bottom"></button></li>
        </ul>

        <div id="navbar-right" class="navbar-flush-right">
          <button id="share-button" class="btn btn-popover btn-default btn-with-border" data-container="body" data-toggle="popover" data-placement="bottom" data-target="share-popover"><i class="fa fa-share"></i>Share</button>
          <!-- Popover content -->
          <div id="share-popover" class="popover fade bottom in" role="tooltip">
            <h3 class="popover-title">Hello World!</h3>
            <div class="popover-content">
              <div class="social-box">
                <div class="facebook"><a href="#">Facebook</a></div>
              </div>
            </div>
          </div>
        </div><!-- navbar-flush-right -->
      </div><!-- .collapse .navbar-collapse -->

    </nav>
  </div><!-- .container-fluid -->
</header><!-- header -->

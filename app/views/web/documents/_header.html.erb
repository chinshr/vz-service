            <li><button title="Numbered List" type="button" class="btn btn-md btn-tlb ql-list fa fa-list-ol"></button></li>
            <li><button title="Bulleted List" type="button" class="btn btn-md btn-tlb ql-bullet fa fa-list-ul"></button></li>
          </ul>
          
          <ul id="media-player-toolbar-container" class="nav navbar-nav toolbar-nav">
            <!-- font-style -->
            <li><button title="Play" type="button" class="btn btn-tlb fa fa-play"></button></li>

<div class="container">
  
  <div id="document-loading" class="document-loading-overlay row" style="display: none">
    <div id="initial-load-error" style="display: none">
      <p>Sorry, we were unable to load your note.</p>
      <p class="reason">Please try again later.</p>
    </div><!-- #initial-load-error -->

    <div id="document-corruption-error" style="display: none">
      <p>Sorry, there's been a problem with the contents of this document.</p>
      <p class="reason"></p>
    </div>

    <div id="document-not-ready-error" style="display: none">
      <p>It's great to see you, but you are a bit early.</p>
      <p class="reason">Your audio is being processed and hasn't finished transcribing, so check back later!</p>
    </div>

    <p title="Loading..." id="loading" style="display: none">Loading...</p>

    <noscript>&lt;strong&gt;Sorry, you have to enable JavaScript in order to use this.&lt;/strong&gt;</noscript>
  </div><!-- .document-loading-overlay -->
  
  <div class="document-overlay row">
    <div class="col-md-1 gutter">
      <div class="note-head user-initials" id="188274716" title="Juergen Fesslmeier" data-bucket-number="0" style="opacity: 1; background-color: rgb(242, 44, 68);">JF</div>
    </div><!-- .gutter -->
    <div class="col-md-10 document-container">
      <div class="title-editor-container">
        <h1><div id="title-editor" class="editor"><%= @document.title %></div></h1>
      </div><!-- title-editor-container -->
      <div class="content-editor-container">
        <div id="content-editor" class="content-holder editor">
          <%= @document.content %>
        </div>
      </div><!-- .content-editor-container -->
    </div><!-- .document-container -->
  </div><!-- .document-overlay -->
</div><!-- .container -->

<% if false %>
<div class="row">
  <div id="" class="col-md-8">
    <%= render "content", edit: true %>
  </div>
  <div class="col-md-4">
    <%= render "sidebar", edit: true %>
  </div>
</div>
<% end %>
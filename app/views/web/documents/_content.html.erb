<%
  edit ||= false
%>
<% if @document.trancribed? %>
<div id="inline-content" class="<%= edit ? 'editor' : '' %> well">
  <%= @document.content %>
</div>
<% else %>
<div id="too-early-alert" class="alert alert-warning">
  <p>
    <i class="glyphicon glyphicon-time"></i>
  </p>
  <h2>It's great to see you, but you are a bit early.</h2>
  <p>Your audio is being processed and hasn't finished transcribing, so check back later!</p>
</div>
<% end %>


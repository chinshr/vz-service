<header class="page-header">
  <div class="container">
    <nav class="navbar navbar-default navbar-fixed-top" id="navigation" role="navigation">
      <div class="container-fluid">
        <div class="navbar-header">
          <a id="logo" class="navbar-brand" href="/">VOYZ.ES</a>
          <% if content_for?(:navbar_tag) %>
            <%= content_for(:navbar_tag) %>
          <% else %>
          <a class="navbar-tag" href="/">Record your Life</a>
          <% end %>
        </div><!-- .navbar-header -->

        <div id="main-navbar" class="navbar-block navbar-block-right">
          <% if false %>
          <ul class="nav navbar-nav navbar-right">
            <% if current_user %>
            <li><!-- profile -->
              <button title="<%= current_user.name_and_username %>" id="profile-button" class="btn btn-md btn-tlb btn-popover btn-profile" type="button" data-toggle="tooltip" data-placement="bottom" data-target="profile-popover-template" data-popover-id="profile-popover" data-popover-class="dropdown-popover profile-popover">
              <%= image_tag(avatar_url(current_user), class: "avatar", style: "background-color: #{current_user.css_hex_color}") %>
              </button>
              <script type="text/html" id="profile-popover-template">
              <ul class="popdown-menu">
                <li role="presentation">
                  <a role="menuitem" href="<%= request.path == web_dashboard_path ? '#' : web_dashboard_path %>">
                  <% if current_user.ingests.started.count > 0 %><span class="badge badge-warning pull-right"><%= current_user.ingests.started.count %></span><% end %>
                  Dashboard</a>
                </li>
                <li role="presentation"><a role="menuitem" href="<%= request.path == web_account_profile_path ? '#' : web_account_profile_path %>">User Profile</a></li>
                <li role="presentation"><a role="menuitem" href="<%= request.path == web_account_settings_path ? '#' : web_account_settings_path %>">Account Settings</a></li>
                <% if false %>
                <li role="presentation"><a role="menuitem" href="<%= request.path == web_account_billing_path ? '#' : web_account_billing_path %>">Billing Information</a></li>
                <% end %>
                <% if current_user.developer_role? %>
                <li role="presentation"><a role="menuitem" href="/documentation">Documentation</a></li>
                <% end %>
                <li role="presentation" class="divider"></li>
                <li role="presentation" class="logout">
                  <%= link_to "Logout", destroy_user_session_path, :method => :delete, :class => "btn btn-small btn-danger" %>
                </li>
              </ul>
              </script>
            </li><!-- /profile -->
            <% end %>
          </ul><!-- nav navbar-nav -->
          <% end %>
          <div class="input-group hidden-xs predictive-search">
            <button class="button button-chromeless button-inline button-with-icon is-in-site-nav-bar button-with-svg-icon" title="Click to start typing a search term" aria-label="Click to start typing a search term" data-action="focus-search-input">
              <span class="icon icon-search icon-size-25px fa fa-search">
              </span>
            </button>
            <input class="predictive-search-input text-input text-input-rounded text-input-transparent text-input-light-text" type="search" placeholder="Search">
          </div><!-- .input-group -->
          <div class="button-set">
            <a class="button button-with-chrome is-in-site-nav-bar" href="/dashboard" data-action-source="nav_upload_story">Upload a story</a>

            <a class="button button-primary button-with-chrome accent-color-border-normal accent-color-text-normal is-in-site-nav-bar" href="<%= new_user_session_path %>" data-action="sign-in-prompt" data-redirect="" data-action-source="nav_signup">Sign in</a>
          </div><!-- .button-set -->

        </div><!-- #main-navbar -->
      </div><!-- container-fluid -->
    </nav><!-- .navbar .navbar-default .navbar-fixed-top -->
  </div><!-- container -->
</header><!-- .page-header -->

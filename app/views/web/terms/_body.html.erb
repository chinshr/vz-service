<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12 full-width">
      <div class="hero hero-plain hero-standard hero-secondary">
        <div class="hero-wrapper xgrid-fixed">
          <div class="hero-inner">
            <h1 class="light"><%= headline %></h1>
          </div>
        </div>
      </div><!-- hero -->
    </div><!-- col-lg-12 full-width -->
  </div><!-- row -->
</div><!-- container-fluid -->

<div class="container content-block">
  <article class="col-lg-9 col-md-9 col-sm-8 col-xs-12 terms-article">
    <%= article %>
  </article><!-- terms-content -->
  <%= render "sidenav" %>
</div><!-- content-block -->
<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12 full-width">
      <div class="hero hero-plain hero-standard hero-secondary">
        <div class="hero-wrapper xgrid-fixed">
          <div class="hero-inner">
            <h1 class="light"><%= headline %></h1>
          </div>
        </div>
      </div><!-- hero -->
    </div><!-- col-lg-12 full-width -->
  </div><!-- row -->
</div><!-- container-fluid -->

<div class="container content-block">
  <div class="col-lg-8 terms-article">
    <%= article %>
  </div><!-- terms-content -->

  <%= render "sidenav" %>
</div><!-- content-block -->
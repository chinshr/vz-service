<%
  type             ||= :javascript
  remote           ||= false
  notifier_options ||= {
    customClass: "#{dom_controller_class} #{dom_controller_action_class}",
    offset: {
      from: "top",
      amount: 10
    },
    align: "right",
    delay: 5000,
  }
%>
<% if type == :javascript %>
  <% if remote %>

    <%= content_for :javascript_includes do %>
      <%= javascript_tag do %>
      $('<%= on %>').on('ajax:complete', function(event, request, status) {
        var message = request.getResponseHeader("X-Message");
        var type = request.getResponseHeader("X-Message-Type");
        var toNotifierType = function(key) {
          switch(key) {
            case 'notice':
              return 'info';
              break;
            case 'success':
              return 'success';
              break;
            case 'error':
              return 'danger';
              break;
            default:
              return 'info';
          }
        }
        console.log(type);
        console.log(message);
        if (message && type) {
          $.notify(message, toNotifierType(type), <%= raw(notifier_options.to_json) %>);
        }
      });
      <% end %>
    <% end %>
  <% else %>
    <%= content_for :javascript_includes do %>
      <%= javascript_tag do %>

        $(function() {
        <% flash.each do |key, message| %>
          $.notify('<%= message %>', '<%= notifier_type_from(key) %>', <%= raw(notifier_options.to_json) %>);
        <% end %>
        });

      <% end %>
    <% end %>
  <% end %>
<% elsif type == :html %>
<div class="row">
  <% flash.each do |key, message| %>
  <!-- <div class="col-md-12"> -->
    <div class="alert alert-<%= dom_alert_class(key) %>">
      <button type="button" class="close" data-dismiss="alert">×</button>
      <%= message %>
    </div>
  <!-- </div> -->
  <% end %>
</div>
<% end %>
<% if resource && !resource.errors.empty? %>
  <%
    messages = resource.errors.full_messages.join(", ")
    notifier_options ||= {
      customClass: "#{dom_controller_class} #{dom_controller_action_class}",
      offset: {
        from: "top",
        amount: 10
      },
      align: "right",
      delay: 5000,
      className: 'error'
    }
  %>
  $(".form-group-captcha").removeClass("has-error");
  $(".form-group-captcha .help-block").remove();
  <% if resource.errors[:captcha] %>
    $(".form-group-captcha").addClass("has-error").append('<p class="help-block"><%= resource.errors[:captcha].join %></p>');
  <% else %>
  <% end %>
  $.notify('<%= messages %>', 'danger', <%= raw(notifier_options.to_json) %>);
<% end %>

<% if resource && !resource.errors.empty? %>
  <%
    style            ||= :notify
    notifier_options ||= {
      customClass: "#{dom_controller_class} #{dom_controller_action_class}",
      offset: {
        from: "top",
        amount: 10
      },
      align: "right",
      delay: 5000,
      className: 'error'
    }
  %>
  $(".form-group-captcha")
    .removeClass("has-error")
    .remove(".help-block");
  <% if resource.errors[:captcha] %>
    $(".form-group-captcha")
      .addClass("has-error")
      .append('<p class="help-block"><%= resource.errors[:captcha].join.humanize %></p>');
  <% end %>

  <% if style == :alert %>
    <%
      messages = resource.errors.full_messages.uniq.map {|msg| content_tag(:li, msg)}.join
      sentence = I18n.t("errors.messages.fill_all_required_fields")
    %>
    $(".alert")
      .html("")
      .append('<%= sentence.html_safe %>')
      .append('<ul><%= messages.html_safe %></ul>')
      .fadeIn();
  <% else %>
    $.notify('<%= resource.errors.full_messages.uniq.join(", ") %>', 'danger', <%= raw(notifier_options.to_json) %>);
  <% end %>
<% end %>

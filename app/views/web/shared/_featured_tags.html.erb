<%
  heading_class_name ||= "heading-bordered-top"
%>
<!-- featured tags-->
<div class="featured-tags">
  <div class="heading clearfix <%= heading_class_name %> heading-all-caps heading-simple">
    <div class="clearfix">
      <div class="heading-content float-left">
        <span class="heading-title">Featured tags</span>
      </div>
      <div class="heading-content float-right">
        <a class="link link-darken accent-color-text-darken" href="#">Learn more</a>
      </div>
    </div>
  </div><!-- .heading -->
  <div class="tags tags-post-tags tags-light">
    <% ActsAsTaggableOn::Tag.most_used.each do |tag| %>
    <a class="link" href="<%= web_explore_tag_path(tag.to_param, {source: "featured"}) %>" data-action-source="featured" data-tag-slug="<%= tag.slug %>"><%= tag.name %></a>
    <% end %>
  </div><!-- .tags .tags-post-tags -->
</div><!-- .featured-tags -->

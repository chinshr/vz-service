<div id="content-loading" class="content-loading-overlay row">
  <div id="load-error" class="message-container" style="display: none">
    <p>Sorry, we were unable to load this content.</p>
    <p class="reason">Please try again later.</p>
  </div><!-- #initial-load-error -->

  <div id="corruption-error" class="message-container" style="display: none">
    <p>Sorry, the content cannot be loaded.</p>
    <p class="reason">Please contact our support.</p>
  </div>

  <div id="not-ready-error" class="message-container" style="display: none">
    <p>It's great to see you, but you are a bit early.</p>
    <p class="reason">Your content is being processed and hasn't finished, so check back later!</p>
  </div>

  <div id="loading" class="message-container">
    <p class="loading spinner" title="Loading..."></p>
  </div>
  <noscript>&lt;strong&gt;Sorry, you have to enable JavaScript in order to use this.&lt;/strong&gt;</noscript>
</div><!-- #content-loading -->

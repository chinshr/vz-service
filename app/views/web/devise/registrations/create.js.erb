$(".form-group-captcha").removeClass("has-error");
$(".form-group-captcha .help-block").remove();
<% if resource.persisted? %>
  <% flash[:notice] = "Sign up successful. Check your email inbox for confirmation instructions." %>
  document.location = "<%= new_user_session_url %>";
<% else %>
  <%= render "web/shared/devise_errors", style: :alert %>
  $("form").find("button[type=submit]").button("reset");
<% end %>

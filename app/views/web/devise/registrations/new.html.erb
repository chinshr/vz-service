<%# Sign up %>
<% page_title "Sign up" %>
<% content_for :javascript_includes do %>
  <%= javascript_tag do %>

  window.ClientSideValidations.validators.remote['registration'] = function(element, options) {
    if ($.ajax({
      url: '/validators/registration',
      data: { id: element.val() },
      // async *must* be false
      async: false
    }).status == 404) {
      return options.message;
    }
  }

  $(function() {
    $("form input[name='user[time_zone]']").val(jstz.determine_timezone().name());
  });

  <% end %>
<% end %>

<%= render "web/shared/devise_errors" %>

<div class="container-fluid content-primary">
  <div class="tile form-tile animated fadeInUp">
    <%= form_for(resource, {as: resource_name, url: user_registration_path(resource), validate: true, remote: true,
        html: {class: "form-signup panel animated fade-in-up"}}) do |f| %>
      <div class="panel-heading">
        <h1 class="logo"><a class="signup-brand" href="/">Sign up here. All we need is your email address.</a></h1>
        <p>Create your account. Your email address is enough to get you started.</p>
      </div>
      <div class="panel-body">
        <div class="form-group">
          <%= f.label :email, "Email address" %>
          <%= f.email_field :email, :autofocus => "autofocus", :autocapitalize => "off", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :class => "form-control first last", :placeholder => "Enter email address", :validate => true, :"data-error-style" => "inline" %>
        </div>
        <div class="form-group sr-only">
          <%= f.label :time_zone, :class => "sr-only" %>
          <%= f.hidden_field :time_zone %>
        </div>
      </div>
      <div class="panel-footer">
        <button class="btn btn-lg btn-primary btn-block" type="submit">Sign up</button>
      </div>
    <% end %>
  </div><!-- form-tile -->

  <div class="text-small text-center text-light text-translucent">
    By clicking Sign up, you agree to the <br />VOYZ.ES <a href="/terms/terms-of-service">Terms of Service</a> and <a href="/terms/privacy-policy">Privacy Policy</a>.
  </div>

  <%= render "devise/shared/links" %>
</div><!-- content-primary -->
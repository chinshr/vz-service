<%
  use_card_expiration_select = true
  form_html_options = if @plan && resource.plan
    {
      role: 'form',
      class: 'form-signup payola-onestep-subscription-form',
      'data-payola-base-path': payola_path,
      'data-payola-plan-type': resource.plan.plan_class,
      'data-payola-plan-id': resource.plan.uid
    }
  else
    {
      role: 'form',
      class: 'form-signup'
    }
  end
%>
<% page_title "Sign up" %>
<% content_for :javascript_includes do %>
  <% if @plan.present? %>
    <%= render 'payola/transactions/stripe_header' %>
  <% end %>
  <%= javascript_tag do %>
  $(function() {
    $("form input[name='user[time_zone]']").val(jstz.determine_timezone().name());
    $("form").find("button[type=submit]").button("reset");
    <% if @plan.blank? %>
    $("form").on('submit', function(e) {
      $(this).find("button[type=submit]").button("loading");
    });
    <% end %>
  });
  <% end %>
<% end %>
<div class="container-fluid content-primary page-wrap gradient-primary">
  <div class="signup-content">
    <div class="header-main">
      <a class="header-logo" href="/"></a>
      <% if @plan %>
      <h2>Sign up for your <%= plan_name(@plan) %> plan today</h2>
      <% else %>
      <h2>Sign up for free and experience VOYZ.ES today</h2>
      <% end %>
      <div class="header-login">
        <span>Already have an account? &nbsp;</span>
        <a id="sign-in-button" class="button button-with-chrome button-sign-in" href="<%= new_user_session_path %>">Sign in</a>
      </div>
    </div><!-- .header-main -->
    <div class="signup-panel panel animated fade-in-up">
      <div class="benefits page-body">
      <% if @plan %>
        <h3><%= plan_name(@plan) %> plan</h3>
        <p>Sign up for your <%= plan_name(@plan) %> plan at <%= plan_price(@plan) %>/<%= plan_interval(@plan) %>. Enjoy <%= plan_features_as_sentence(@plan) %> Check <a href="<%= web_pricing_path %>">pricing</a> for more options.</p>
        <h3>Transcribe and edit</h3>
        <p>Automatically transcribe your media, video or audio, recorded from your favorite device. Edit your media documents with others to improve quality.</p>

        <h3>Share and collaborate</h3>
        <p>Share your media documents and collaborate with others.</p>
      <% else %>
        <h3>Free account</h3>
        <p>Sign up for your Free plan. Enjoy <%= plan_features_as_sentence("free") %>. Check our <a href="<%= web_pricing_path %>">paid plans</a> for more options.</p>
        <h3>Transcribe and edit</h3>
        <p>Automatically transcribe your media (video or audio) recorded from your favorite device. Edit your media documents with others to improve quality.</p>
        <h3>Share and collaborate</h3>
        <p>Share your media documents and collaborate with others.</p>
      <% end %>
      </div><!-- .benefits -->
      <div class="signup page-sidebar">
        <%= render "web/shared/devise_errors", style: :alert %>
        <%= form_for(resource, {as: resource_name, url: user_registration_path(resource), validate: true, remote: true, authenticity_token: true, html: form_html_options}) do |f| %>
          <p class="alert alert-error payola-payment-error" id="fill-all-fields"></p>
          <%= f.hidden_field :time_zone -%>
          <% if User::SIGNUP_ATTRIBUTES.include?(:name) %>
          <div class="form-group form-group-name">
            <%= f.label :name, form_label_required("Full name"), :class => "" %>
            <%= f.text_field :name, :class => "form-control name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Full name", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-name -->
          <% end %>
          <% if User::SIGNUP_ATTRIBUTES.include?(:first_name) %>
          <div class="form-group form-group-first-name">
            <%= f.label :first_name, form_label_required("First name"), :class => "" %>
            <%= f.text_field :first_name, :class => "form-control first-name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "First name", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-first-name -->
          <% end %>
          <% if User::SIGNUP_ATTRIBUTES.include?(:last_name) %>
          <div class="form-group form-group-last-name">
            <%= f.label :last_name, form_label_required("Last name"), :class => "" %>
            <%= f.text_field :last_name, :class => "form-control last-name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Last name", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-last-name -->
          <% end %>
          <% if User::SIGNUP_ATTRIBUTES.include?(:username) %>
          <div class="form-group form-group-username">
            <%= f.label :username, form_label_required("Username"), :class => "" %>
            <%= f.text_field :username, :class => "form-control", :autocomplete => "off", :placeholder => "Username", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-username -->
          <% end %>
          <div class="form-group form-group-email">
            <%= f.label :email, form_label_required("Email address"), :class => "" %>
            <%= f.email_field :email, :autofocus => "autofocus", :autocapitalize => "off", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :class => "form-control", :placeholder => "Email address", :validate => true, data: {"error-style": "inline", payola: 'email'} %>
          </div><!-- .form-group .form-group-email -->
          <noscript>
            <p>We need you to enable JavaScript for signing up.<br />If this is an issue for you, please let us know at <%= mail_to "support@voyz.es" %></p>
          </noscript>
          <% if requires_captcha? %>
          <div class="form-group form-group-captcha">
            <div class="recaptcha-wrap">
            <%= recaptcha_tags hl: I18n.locale_language %>
            </div>
          </div><!-- .form-group -->
          <% end %>
          <% if @plan %>
            <%= render "web/account/payment_methods/card_fields", use_card_expiration_select: use_card_expiration_select,
              display_card_form_label: true %>
          <% end %>
          <div class="form-group">
          <% if @plan %>
          <button class="btn btn-lg btn-primary btn-block" type="submit" data-loading-text="Signing up...">Create <%= plan_name(@plan) %> Plan</button>
          <% else %>
          <button class="btn btn-lg btn-primary btn-block" type="submit" data-loading-text="Signing up...">Create Free Account</button>
          <% end %>
          </div><!-- .form-group -->
          <p class="privacy privacy-tos">By signing up, you agree to the VOYZ.ES <a href="/terms/terms-of-service">Terms of Service</a> and <a href="/terms/privacy-policy">Privacy Policy</a>.</p>
        <% end %>
      </div><!-- .signup -->
    </div><!-- .signup-panel -->
  </div><!-- .signup-content -->
</div><!-- .container-fluid -->

<%#  Confirmation show %>
<% page_title "Confirm" %>
<% content_for :javascript_includes do %>
  <%= javascript_tag do %>

  window.ClientSideValidations.validators.remote['username_format'] = function(element, options) {
    if ($.ajax({
      url: '/validators/username_format',
      data: { username: element.val() },
      // async *must* be false
      async: false
    }).status === 422) {
      return options.message;
    }
  }

  $(function() {
    $("input[readonly]").attr("readonly", null); // .blur().focus();
    $("form").on('submit', function(e) {
      $(this).find("button[type=submit]").button("loading");
    });
  });

  <% end %>
<% end %>
<%= render "web/shared/devise_errors" %>
<div class="container-fluid content-primary page-wrap gradient-primary">
  <div class="confirmation-content">
    <div class="tile form-tile animated fadeInUp">
      <%= form_for(resource, {:as => resource_name, :url => confirmation_path(resource), validate: true, remote: true, method: :put,
          html: {class: "form-signin panel animated fade-in-up", autocomplete: "off"}}) do |f| %>
        <!-- prevent unwanted autocomplete in Chrome -->
        <input style="display:none">
        <input type="password" style="display:none">
        <div class="panel-heading">
          <h1 class="logo"><a class="signup-brand" href="/">Confirm your account with VOYZ.ES</a></h1>
          <p>You're almost done...</p>
        </div>
        <div class="panel-body">

          <% if User::SIGNUP_ATTRIBUTES.include?(:name) && resource.name.blank? %>
          <div class="form-group form-group-name">
            <%= f.label :name, form_label_required("Full name"), :class => "xsr-only" %>
            <%= f.text_field :name, :class => "form-control name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Full name", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-name -->
          <% end %>

          <% if User::SIGNUP_ATTRIBUTES.include?(:first_name) && resource.first_name.blank? %>
          <div class="form-group form-group-first-name">
            <%= f.label :first_name, form_label_required("First name"), :class => "xsr-only" %>
            <%= f.text_field :first_name, :class => "form-control first-name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "First name", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-first-name -->
          <% end %>

          <% if User::SIGNUP_ATTRIBUTES.include?(:last_name) && resource.last_name.blank? %>
          <div class="form-group form-group-last-name">
            <%= f.label :last_name, form_label_required("Last name"), :class => "xsr-only" %>
            <%= f.text_field :last_name, :class => "form-control last-name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Last name", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-last-name -->
          <% end %>

          <% if User::SIGNUP_ATTRIBUTES.include?(:username) && resource.username.blank? %>
          <div class="form-group form-group-username">
            <%= f.label :username, form_label_required("Username"), :class => "xsr-only" %>
            <%= f.text_field :username, :class => "form-control", :autocomplete => "off", :placeholder => "Your username", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .form-group .from-group-username -->
          <% end %>

          <div class="form-group form-group-password">
            <%= f.label :password, form_label_required("Password"), :class => "xsr-only" %>
            <%= f.password_field :password, :class => "form-control", :autocomplete => "off", :placeholder => "Choose a password", :validate => false, :"data-error-style" => "inline" %>
          </div><!-- from-group-password -->

          <%= hidden_field_tag :confirmation_token, @confirmation_token %>
        </div>
        <div class="panel-footer">
          <button class="btn btn-lg btn-primary btn-block" type="submit" data-loading-text="Finishing...">Finish</button>
        </div>
      <% end %>
    </div><!-- .form-tile -->
  </div><!-- .confirmation-content -->
</div><!-- .content-primary -->

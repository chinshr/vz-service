<%#  Confirmation show %>
<% page_title "Confirm" %>
<% content_for :javascript_includes do %>
  <%= javascript_tag do %>

  window.ClientSideValidations.validators.remote['username_format'] = function(element, options) {
    if ($.ajax({
      url: '/validators/username_format',
      data: { username: element.val() },
      // async *must* be false
      async: false
    }).status === 422) {
      return options.message;
    }
  }

  $(function() {
    $("input[readonly]").attr("readonly", null); // .blur().focus();
    $("form").on('submit', function(e) {
      $(this).find("button[type=submit]").button("loading");
    });
  });

  <% end %>
<% end %>

<%= render "web/shared/devise_errors" %>

<div class="container-fluid content-primary">
  <div class="tile form-tile animated fadeInUp">
    <%= form_for(resource, {:as => resource_name, :url => confirmation_path(resource), validate: true, remote: true, method: :put,
        html: {class: "form-signin panel animated fade-in-up", autocomplete: "off"}}) do |f| %>
      <div class="panel-heading">
        <h1 class="logo"><a class="signup-brand" href="/">Confirm your account with VOYZ.ES</a></h1>
        <p>You're almost done...</p>
      </div>
      <div class="panel-body">
        <div class="form-group form-group-name">
          <%= f.label :name, "Name", :class => "sr-only" %>
          <div class="input-group">
            <span class="input-group-addon input-group-email-addon"><i class="fa fa-user"></i></span>
            <%= f.text_field :name, :class => "form-control name", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Your name, e.g. Joe Smith", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .input-group -->
        </div><!-- .form-group .from-group-name -->

        <div class="form-group form-group-username">
          <%= f.label :username, "Username", :class => "sr-only" %>
          <div class="input-group">
            <span class="input-group-addon input-group-email-addon"><i class="fa fa-at"></i></span>
            <%= f.text_field :username, :readonly => "", :class => "form-control", :autocomplete => "off", :placeholder => "Your username", :validate => true, :"data-error-style" => "inline" %>
          </div><!-- .input-group -->
        </div><!-- .form-group .from-group-username -->

        <div class="form-group form-group-password">
          <%= f.label :password, "Password", :class => "sr-only" %>
          <div class="input-group">
            <span class="input-group-addon input-group-email-addon"><i class="fa fa-key"></i></span>
            <%= f.password_field :password, :class => "form-control", :readonly => "", :autocomplete => "off", :placeholder => "Choose a password", :validate => false, :"data-error-style" => "inline" %>
          </div><!-- .input-group -->
        </div><!-- from-group-password -->

        <%= hidden_field_tag :password, "" %>
        <%= hidden_field_tag :confirmation_token, @confirmation_token %>
      </div>
      <div class="panel-footer">
        <button class="btn btn-lg btn-primary btn-block" type="submit" data-loading-text="Finishing...">Finish</button>
      </div>
    <% end %>
  </div><!-- form-tile -->
</div><!-- content-primary -->
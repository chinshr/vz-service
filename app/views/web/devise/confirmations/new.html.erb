<%#  Resend confirmation %>
<% page_title "Resend confirmation" %>
<%= render "web/shared/devise_errors" %>
<% content_for :javascript_includes do %>
  <%= javascript_tag do %>

  $(function() {
    $("form").find("button[type=submit]").button("reset");
    $("form").on('submit', function(e) {
      $(this).find("button[type=submit]").button("loading");
    });
  });

  <% end %>
<% end %>

<div class="container-fluid content-primary">
  <div class="tile form-tile animated fadeInUp">
    <%= form_for(resource, :as => resource_name, :url => confirmation_path(resource_name),
        :html => {:method => :post, :class => "form-signup  panel animated fade-in-up"}) do |f| %>
      <div class="panel-heading">
        <h1 class="logo"><a class="signup-brand" href="/">Resend confirmation email.</a></h1>
        <p>Submit your email address to receive confirmation instructions. </p>
      </div>
      <div class="panel-body">
        <div class="form-group">
          <%= f.label :email, "Email address", :class => "sr-only" %>
          <span class="input-icon input-icon-email"><i class="fa fa-user"></i></span>
          <%= f.email_field :email, :autofocus => "autofocus", :autocapitalize => "off", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :class => "form-control first last form-control-with-input-icon", :placeholder => "Email address" %>
        </div>
      </div>
      <div class="panel-footer">
        <button class="btn btn-lg btn-primary btn-block" type="submit" data-loading-text="Resending confirmation...">Resend Confirmation</button>
      </div>
    <% end %>
  </div><!-- form-tile -->

  <div class="text-small text-center text-light text-translucent">
    If you don't receive any instruction email from us, <br />try to unblock VOYZ.ES in your email spam settings.
  </div>

  <%= render "devise/shared/links" %>
</div><!-- content-primary -->

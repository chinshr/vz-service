<%#  Confirmation show %>
<% content_for :header do %>
  <%= render "shared/web/devise_errors" %>
<% end %>

<div class="container-fluid content-primary">
  <%#= render "devise/shared/login_quote" %>

  <div class="tile form-tile animated fadeInUp">
    <%= form_for(resource, :as => resource_name, :url => confirmation_path(resource_name), 
        :html => {:method => :put, :class => "form-signin panel animated fade-in-up"}) do |f| %>
      <div class="panel-heading">
        <h1 class="logo"><a class="signup-brand" href="/">Confirm your account with VOYZ.ES</a></h1>
        <p>You're almost done...</p>
      </div>
      <div class="panel-body">

        <div class="form-group from-group-first-name">
          <%= f.label :first_name, "First Name" %>
          <%= f.text_field :first_name, :class => "form-control first", :autofocus => "autofocus", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Enter first name" %>
        </div><!-- from-group-first-name -->
        
        <div class="form-group from-group-last-name">
          <%= f.label :last_name, "Last Name" %>
          <%= f.text_field :last_name, :class => "form-control first", :autocapitalize => "on", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :placeholder => "Enter last name" %>
        </div><!-- from-group-last-name -->

        <div class="form-group from-group-password">
          <%= f.label :password, "Password" %>
          <%= f.password_field :password, :class => "form-control", :autocomplete => "off", :placeholder => "Enter password" %>
        </div><!-- from-group-password -->

        <div class="form-group from-group-password-confirmation">
          <%= f.label :password_confirmation, "Password confirmation" %>
          <%= f.password_field :password_confirmation, :class => "form-control", :autocomplete => "off", :placeholder => "Repeat password" %>
        </div><!-- from-group-password-confirmation -->

        <%= hidden_field_tag :confirmation_token, @confirmation_token %>
        
      </div>  
      <div class="panel-footer">
        <button class="btn btn-lg btn-primary btn-block" type="submit">Finish</button>
      </div>
    <% end %>
  </div><!-- form-tile -->
</div><!-- content-primary -->

<%= render "devise/footer" %>

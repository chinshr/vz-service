<% content_for :header do %>
  <%= render "shared/web/devise_errors" %>
<% end %>
<a class="signup-brand" href="/">home</a>
<%= form_for(resource, {:as => resource_name, :url => session_path(resource_name), 
    :html => {:class => "form-signin well"}}) do |f| %>
  <h2 class="form-signin-heading">Please sign in</h2>

  <%= f.email_field :email, :autofocus => "autofocus", :autocapitalize => "off", :autocomplete => "off", :autocorrect => "off", :spellcheck => false, :class => "form-control first", :placeholder => "Email address" %>
  <%= f.password_field :password, :class => "form-control last", :placeholder => "Password" %>

  <% if devise_mapping.rememberable? -%>
    <label class="checkbox"><%= f.check_box :remember_me %> <%= f.label :remember_me %></label>
  <% end -%>

  <button class="btn btn-lg btn-primary btn-block" type="submit">Sign in</button>

  <%= render "devise/shared/links" %>
<% end %>


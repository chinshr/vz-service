<% page_title "Sign in" %>
<%= render "web/shared/devise_errors" %>
<% content_for :javascript_includes do %>
  <%= javascript_tag do %>

  $(function() {
    $("form").on('submit', function(e) {
      $(this).find("button[type=submit]").button("loading");
    });
  });

  history.navigationMode = 'compatible';
  $(document).ready(function() {
    $(this).find("button[type=submit]").button("reset");
  });

  $(window).bind('beforeunload', function() {
    $(this).find("button[type=submit]").button("reset");
  });

  <% end %>
<% end %>

<div class="container-fluid content-primary">
  <%= render "devise/shared/login_quote" %>

  <div class="tile form-tile animated fade-in-up">
    <%= form_for(resource, {:as => resource_name, :url => session_path(resource_name),
        :html => {:class => "form-signin panel"}}) do |f| %>
      <div class="panel-heading">
        <h1 class="logo"><a class="signup-brand" href="/">Login to VOYZ.ES</a></h1>
        <p>Welcome back!</p>
      </div>
      <div class="panel-body">
        <div class="form-group">
          <%= f.label :email, "Email address", :class => "sr-only" %>
          <%= f.email_field :email, :autofocus => "autofocus", :autocapitalize => "off", :autocomplete => "new-user-session", :autocorrect => "off", :spellcheck => false, :class => "form-control first", :placeholder => "Enter email address" %>
        </div>
        <div class="form-group">
          <%= f.label :password, "Password", :class => "sr-only" %>
          <%= f.password_field :password, :class => "form-control last", :placeholder => "Enter password", autocomplete: "new-user-session" %>
        </div>

        <% if devise_mapping.rememberable? -%>
          <label class="checkbox"><%= f.check_box :remember_me %> <%= f.label :remember_me %></label>
        <% end -%>
      </div>
      <div class="panel-footer">
        <button class="btn btn-lg btn-primary btn-block" type="submit" data-loading-text="Signing in...">Sign in</button>
      </div>
    <% end %>
  </div><!-- form-tile -->

  <%= render "devise/shared/links" %>
</div><!-- content-primary -->

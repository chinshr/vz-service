<%# Signup %>
<% content_for :header do %>
  <%= render "shared/web/devise_errors" %>
<% end %>
<a class="signup-brand" href="/">home</a>
<%= form_for(resource, :as => resource_name, :url => user_registration_path(resource), :validate => true, 
    :html => {:class => "form-signup well"}) do |f| %>
  <h2>Sign up here. All we need is your email address.</h2>

  <div class="clearfix">
    <%= f.label :email %>
    <div class="input">
      <%= f.email_field :email, :autofocus => true, :class => "form-control first", :placeholder => "Email address" %>
    </div>
  </div>

  <button class="btn btn-lg btn-primary btn-block" type="submit">Sign up</button>

  <%= render "devise/shared/links" %>
<% end %>


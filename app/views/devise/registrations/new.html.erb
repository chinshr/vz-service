<%# Signup %>
<% content_for :header do %>
  <%= render "shared/web/devise_errors" %>
<% end %>
<%= form_for(resource, :as => resource_name, :url => user_registration_path(resource), 
    :html => {:class => "form-signup well"}) do |f| %>
  <h2>Sign up. All we need is your email address.</h2>

  <%= f.email_field :email, :autofocus => true, :class => "form-control first", :placeholder => "Email address" %>

  <button class="btn btn-lg btn-primary btn-block" type="submit">Sign up</button>

  <%= render "devise/shared/links" %>
<% end %>


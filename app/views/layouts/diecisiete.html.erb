<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="description" content="Record your Life. Your conversations deserve a place to be found.">
    <meta name="author" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : "VOYZ.ES" %></title>
    <%= csrf_meta_tags %>

    <!-- Add to homescreen for Chrome on Android -->
    <meta name="mobile-web-app-capable" content="yes">

    <%=h yield(:head_includes) %>

    <link rel="dns-prefetch" href="//fonts.googleapis.com">

    <!-- Bootstrap core CSS -->
    <%= stylesheet_link_tag "diecisiete" %>

    <!-- Add modernizr -->
    <%= javascript_include_tag :modernizr %>

    <!-- For third-generation iPad with high-resolution Retina display: -->
    <!-- Size should be 144 x 144 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-144x144-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '144x144' %>

    <!-- For iPhone with high-resolution Retina display: -->
    <!-- Size should be 114 x 114 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-114x114-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '114x114' %>

    <!-- For first- and second-generation iPad: -->
    <!-- Size should be 72 x 72 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-72x72-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '72x72' %>

    <!-- For non-Retina iPhone, iPod Touch, and Android 2.1+ devices: -->
    <!-- Size should be 57 x 57 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png' %>

    <!-- For all other devices -->
    <!-- Size should be 32 x 32 pixels -->
    <%= favicon_link_tag 'favicon.ico', :rel => 'shortcut icon', :type => 'image/vnd.microsoft.icon' %>

    <!-- HTML5 shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
    <%= javascript_include_tag "lib/html5shiv.js" %>
    <%= javascript_include_tag "lib/respond.min.js" %>
    <![endif]-->

    <%= javascript_include_tag "web/drift.js" %>
  </head>

  <body data-spy="scroll" data-offset="70" data-target="#navigation" class="<%= dom_controller_class %> <%= dom_controller_action_class %> selected-main-item">
    <header class="page-header">
      <div class="container">
        <nav class="navbar navbar-default navbar-inverse navbar-fixed-top" id="navigation" role="navigation">
          <div class="container-fluid">
            <div class="navbar-header">
              <a id="logo" class="navbar-brand" href="/">VOYZ.ES<span class="beta-label">beta</span></a>
              <a class="navbar-tag" href="/">Record your Life</a>
            </div><!-- .navbar-header -->
            <div id="slidemenu">
              <ul class="nav navbar-nav">
                <li>
                  <div class="button-set">
                    <a href="<%= new_user_session_path %>" title="Sign in" id="sign-in-button" class="button button-with-chrome button-sign-in" type="button">Sign in</a>
                    <span class="button-set-divider"></span>
                    <a href="<%= new_user_registration_path %>" title="Join" id="sign-up-button" class="button button-with-chrome button-sign-up" type="button">Join</a>
                  </div><!-- .button-set -->
                </li>
                <li>
                  <a href="/pricing" title="Pricing" id="pricing-button" class="button button-chromeless button-pricing" type="button">Pricing</a>
                </li>
                <li>
                  <a href="/faqs" title="Frequently Asked Questions" id="faqs-button" class="button button-chromeless button-faqs" type="button">Help</a>
                </li>
              </ul>
            </div><!-- .slidemenu -->
            <!-- menu items -->
            <div id="main-navbar" class="navbar-block navbar-block-right">
              <div class="button-set show-xs">
                <a class="navbar-toggle">
                  <span class="burger-menu">
                </a>
              </div>
              <div class="button-set hidden-xs">
                <a href="/pricing" title="Pricing" id="pricing-button" class="button button-chromeless button-pricing" type="button">Pricing</a>
                <a href="/faqs" title="Frequently Asked Questions" id="faqs-button" class="button button-chromeless button-faqs" type="button">Help</a>
                <a href="<%= new_user_session_path %>" title="Sign in" id="sign-in-button" class="button button-with-chrome button-sign-in" type="button">Sign in</a>
                <span class="button-set-divider"></span>
                <a href="<%= new_user_registration_path %>" title="Join" id="sign-up-button" class="button button-with-chrome button-sign-up" type="button">Join</a>
              </div><!-- .button-set -->
            </div><!-- #main-navbar -->
          </div><!-- .container-fluid -->
        </nav>
      </div><!-- .container -->
    </header>
    <div id="content">
      <div id="main">
        <div class="background-image" data-image-src="assets/diecisiete/home-background.jpg"></div>
        <div class="credits"><i class="fa fa-camera"></i><a href="https://www.flickr.com/photos/andreannegermain/3657279001/in/photolist-6zbvCv-4Nyswd-e8pNeB-ah7VtK-qQnrdn-qC7VwB-aAhGN-ahaPRs-sv7Ay-ahaNrN-ahaR1h-pGyyg6-oab4aU-a5PQ74-5B5qmn-dTh3TK-QGksd-rqgJut-cT2rVj-smN3vg-9GWTqE-cAy57Q-aCiG9H-jF61mZ-bKDCW-8PXy5e-ow7sSt-6y3iZT-dAqy75-e2NmBD-85iojw-77K6QU-6Z4xYU-oNkq28-aEnCcR-skEP7j-iyuh9-APj9R-jMGeSQ-JCSDt-cisJVC-7CGHDr-jvGmpe-cygj3u-cpjCBY-kVCiyi-3jTmvE-psGrzQ-hGo273-izzc9E" target="_blank">Andréanne Germain</a></div>
        <div class="container">
          <div class="right-aligned row">
            <div class="content-gradient">
              <div id="siri-wave"></div>
            </div>
            <!-- right aligned -->
            <div class="col-lg-7 col-lg-offset-5 col-md-8 col-md-offset-4 col-sm-10 col-sm-offset-1 col-xs-12">
              <div class="content-wrapper">

                <div class="intro">
                  <p>
                    Your conversations<br/>
                    <span id="typed">deserve a place to be found</span>
                  </p>
                </div>
                <div id="typed-strings">
                  <p>are transcribed automatically</p>
                  <p>can be edited collaboratively</p>
                  <p>are stored safely</p>
                  <p>can be shared easily</p>
                  <p>are encrypted</p>
                  <p>deserve a place to be found</p>
                </div>

                <div class="actions">

                  <div class="actions-stacked">
                    <div class="our-story-play youtube">
                      <div class="circle-block">
                        <div class="circle-centered">
                          <div class="i-block"><i class="i-centered fa fa-play-circle"></i></div>
                        </div>
                      </div>
                    </div><!-- .our-story-play -->
                  </div><!-- .actions-left -->

                  <div class="actions-stacked">
                    <div class="button-set align-right">
                      <a href="/pricing" title="Additional plans" id="more-button" class="button button-with-chrome button-more" type="button">Pricing</a>
                      <span class="button-set-divider"></span>
                      <a href="<%= new_user_registration_path %>" title="Join" id="sign-up-button" class="button button-with-chrome button-sign-up" type="button">Join for free<sup>*</sup></a>
                    </div><!-- .button-set -->
                    <div class="btw">
                      <p><sup>*</sup>No credit card required</p>
                    </div><!-- .btw -->
                  </div><!-- .actions-right -->
                </div><!-- .actions -->
              </div><!-- .content-wrapper -->
            </div><!-- .col -->
          </div><!-- .right-aligned -->
        </div><!-- .container -->
      </div><!-- #main -->

      <!-- gallery -->
      <div id="gallery">
        <div class="inner-shadow"></div>
        <div class="navigation">
          <div id="home-gallery-item-1" class="item-selected"><div>Upload</div></div>
          <div id="home-gallery-item-2" class="item"><div>Transcribe</div></div>
          <div id="home-gallery-item-3" class="item"><div>Share</div></div>
          <div style="clear:both"></div>
          <div class="selector" style="left: 0%;"></div>
        </div>
        <div class="bottom-line"></div>
        <div class="dots-navigation">
          <div id="home-gallery-dot-1" class="dot-on"></div>
          <div id="home-gallery-dot-2" class="dot-off"></div>
          <div id="home-gallery-dot-3" class="dot-off"></div>
        </div>
        <a href="#" id="slide-1" class="slide slide-selected">
          <h2>Securely upload and store</h2>
          <p>the sound of any media file</p>
          <img data-src="<%= image_path("diecisiete/slide1.png") %>" src="<%= image_path("diecisiete/slide1.png") %>">
        </a>
        <a href="#" id="slide-2" class="slide" style="display: none;">
          <h2>Automatically transcribe and edit</h2>
          <p>Improve transcripts yourself or with others</p>
          <img data-src="<%= image_path("diecisiete/slide2.png") %>" src="<%= image_path("diecisiete/slide2.png") %>">
        </a>
        <a href="#" id="slide-3" class="slide" style="display: none;">
          <h2>Share and discover</h2>
          <p>Find voices from around the world</p>
          <img data-src="<%= image_path("diecisiete/slide3.png") %>" src="<%= image_path("diecisiete/slide3.png") %>">
        </a>
      </div><!-- gallery -->

      <div id="benefits">
        <div id="parallax" class="xparallax" data-speed="10"></div>
        <div id="particles"></div>
        <div class="container">
          <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-2 col-sm-10 col-sm-offset-1 col-xs-12">
              <h2>Deep insights. Unlimited.</h2>
              <ul class="custom-bullet">
                <li class="one">
                  <p><b>VOYZ.ES</b> helps organize and automatically extract structured information from recordings.</p>
                </li>
                <li class="two">
                  <p>Allows you to share your conversations and harness your findings from in depth insights.</p>
                </li>
                <li class="three">
                  <p>Employs the latest in neuronal network based ASR and NLP technology.</p>
                </li>
                <li class="four">
                  <p>Continuously improves the quality of transcripts for English, Spanish and soon, other languages.</p>
                </li>
              </ul><!-- .custom-bullet -->
            </div><!-- .col -->
          </div><!-- .row -->
        </div><!-- .container -->
      </div><!-- parallax -->

      <div id="contact">
        <div class="social">
          <a href="http://twitter.com/voyzes" title="Twitter" class="social twitter"><i class="fa fa-twitter"></i></a>
          <a href="http://facebook.com/voyzes" class="social facebook"><i class="fa fa-facebook-official"></i></a>
          <a href="http://linkedin.com/voyzes" class="social linked-in"><i class="fa fa-linkedin-square"></i></a>
          <div class="clear"></div>
        </div><!-- .social -->

        <p>If you have any feedback or suggestions</p>
        <%= render "web/pages/contacts/form" %>
        <div class="button button-with-chrome button-contact-us">Contact us</div>
      </div><!-- #contact -->

      <footer>
        <div class="wrapper">
          <div class="left">
            <h5><a class="logo" href="/">VOYZ.ES</a></h5>
            <a href="/faqs">Help</a>
            <a href="/pricing">Pricing</a>
          </div><!-- .left -->
          <div class="right">
            <span class="copy">&copy;&nbsp;<%= Time.zone.now.year %> VOYZES, Inc. · All rights reserved</span>
            <a id="footer-privacy" href="/terms/privacy-policy">Privacy</a><a href="/terms/terms-of-service">Terms of Service</a>
          </div><!-- .right -->
        </div><!-- .wrapper -->
      </footer>
    </div><!-- #content -->
    <%= javascript_include_tag "diecisiete" %>
    <%= yield :javascript_includes %>
    <div id="fb-root"></div>
  </body>
</html>

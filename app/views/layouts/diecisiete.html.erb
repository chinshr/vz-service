<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="description" content="Record your Life. Your conversations deserve a place to be found.">
    <meta name="author" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : "VOYZ.ES" %></title>
    <%= csrf_meta_tags %>

    <!-- Add to homescreen for Chrome on Android -->
    <meta name="mobile-web-app-capable" content="yes">

    <%=h yield(:head_includes) %>

    <link rel="dns-prefetch" href="//fonts.googleapis.com">

    <!-- Bootstrap core CSS -->
    <%= stylesheet_link_tag "diecisiete" %>

    <!-- Add modernizr -->
    <%= javascript_include_tag :modernizr %>

    <!-- For third-generation iPad with high-resolution Retina display: -->
    <!-- Size should be 144 x 144 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-144x144-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '144x144' %>

    <!-- For iPhone with high-resolution Retina display: -->
    <!-- Size should be 114 x 114 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-114x114-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '114x114' %>

    <!-- For first- and second-generation iPad: -->
    <!-- Size should be 72 x 72 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-72x72-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '72x72' %>

    <!-- For non-Retina iPhone, iPod Touch, and Android 2.1+ devices: -->
    <!-- Size should be 57 x 57 pixels -->
    <%= favicon_link_tag 'apple-touch-icon-precomposed.png', :rel => 'apple-touch-icon-precomposed', :type => 'image/png' %>

    <!-- For all other devices -->
    <!-- Size should be 32 x 32 pixels -->
    <%= favicon_link_tag 'favicon.ico', :rel => 'shortcut icon', :type => 'image/vnd.microsoft.icon' %>

    <!-- HTML5 shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
    <%= javascript_include_tag "lib/html5shiv.js" %>
    <%= javascript_include_tag "lib/respond.min.js" %>
    <![endif]-->
  </head>

  <body data-spy="scroll" data-offset="70" data-target="#navigation" class="<%= dom_controller_class %> <%= dom_controller_action_class %> selected-main-item">
    <div id="content">
      <header class="page-header">
        <div class="container">
          <nav class="navbar navbar-default navbar-fixed-top" id="navigation" role="navigation">
            <div class="container-fluid">
              <div class="navbar-header">
                <a id="logo" class="navbar-brand" href="/">VOYZ.ES</a>
                <a class="navbar-tag" href="/">Record your Life</a>
              </div><!-- .navbar-header -->

              <!-- menu items -->
              <div id="main-navbar" class="navbar-block navbar-block-right">
                <div class="button-set">
                  <a href="/pricing" title="Pricing" id="pricing-button" class="button button-chromeless button-pricing" type="button">Pricing</a>
                  <a href="/faqs" title="Frequently Asked Questions" id="faqs-button" class="button button-chromeless button-faqs" type="button">FAQs</a>
                  <a href="<%= new_user_session_path %>" title="Sign in" id="sign-in-button" class="button button-with-chrome button-sign-in" type="button">Sign in</a>
                  <span class="button-set-divider"></span>
                  <a href="<%= new_user_registration_path %>" title="Join" id="sign-up-button" class="button button-with-chrome button-sign-up" type="button">Join</a>
                </div><!-- .button-set -->
              </div><!-- #main-navbar -->
              <!-- end menu items -->

            </div><!-- .container-fluid -->
          </nav>
        </div><!-- .container -->
      </header>

      <!-- background -->
      <div id="main">
        <div class="container">
          <div class="right-aligned row">
            <div class="cont-gradient">
              <div id="siri-wave"></div>
            </div>
            <!-- right aligned -->
            <div class="col-lg-7 col-lg-offset-5 col-md-8 col-md-offset-4 col-sm-10 col-sm-offset-1 col-xs-12">
              <div class="cont-wrapper">
                <p class="intro">Your conversations <br/>deserve a place to be found</p>
              </div><!-- .cont-wrapper -->
            </div><!-- .col -->
          </div><!-- .right-aligned -->
          <div class="center-aligned row">
            <div class="col-lg-6 col-lg-offset-3 col-md-8 col-md-offset-2 col-sm-10 col-sm-offset-1 col-xs-12">
                <div class="actions">

                  <div class="our-story-play" data-href="https://www.youtube.com/watch?v=w2oLFpcMPlo">
                    <div class="circle-block">
                      <div class="circle-centered">
                        <div class="i-block"><i class="i-centered fa fa-play-circle"></i></div>
                      </div>
                    </div>
                  </div>

                </div><!-- .actions -->
            </div><!-- end cendered -->
          </div><!-- .center-aligned .row -->
        </div><!-- .container -->
      </div><!-- #main -->

      <!-- gallery -->
      <div id="gallery">
        <div class="inner-shadow"></div>
        <div class="navigation">
          <div id="home-gallery-item-1" class="item-selected"><div>Upload &amp; Store</div></div>
          <div id="home-gallery-item-2" class="item"><div>Transcribe &amp; Edit</div></div>
          <div id="home-gallery-item-3" class="item"><div>Collaborate &amp; Discover</div></div>
          <div style="clear:both"></div>
          <div class="selector" style="left: 0%;"></div>
        </div>
        <div class="bottom-line"></div>
        <div class="dots-navigation">
          <div id="home-gallery-dot-1" class="dot-on"></div>
          <div id="home-gallery-dot-2" class="dot-off"></div>
          <div id="home-gallery-dot-3" class="dot-off"></div>
        </div>
        <a href="#" id="slide-1" class="slide slide-selected">
          <h2>Securely upload and store</h2>
          <p>Any audio or video file</p>
          <img data-src="<%= image_path("diecisiete/slide1.png") %>" src="<%= image_path("diecisiete/slide1.png") %>">
        </a>
        <a href="#" id="slide-2" class="slide" style="display: none;">
          <h2>Automatically transcribe and edit</h2>
          <p>And extract information</p>
          <img data-src="<%= image_path("diecisiete/slide2.png") %>" src="<%= image_path("diecisiete/slide2.png") %>">
        </a>
        <a href="#" id="slide-3" class="slide" style="display: none;">
          <h2>Collaborate and Discover</h2>
          <p>&nbsp;</p>
          <img data-src="<%= image_path("diecisiete/slide3.png") %>" src="<%= image_path("diecisiete/slide3.png") %>">
        </a>
      </div><!-- gallery -->

      <div id="parallax" data-speed="8" class="hidden-sm hidden-xs">
        <div class="container">
           <div class="row">
            <div class="col-lg-8 col-lg-offset-2">
              <h2>What we do</h2>
              <p><b>VOYZ.ES</b> helps organize and automatically extract structured information from recordings.</p>
              <p>Simultaniously collaborate with others on voice documents. Media producers and Universities use <b>VOYZ.ES</b> to team up on transcripts for their videos and podcasts.</p>
              <p>Share all or portions of your conversations and harness your findings from in depth insights.</p>
              <p><b>VOYZ.ES</b> employes the latest in neuronal network based ASR and NLP technology. It is continuously improving the quality of its transcripts for English, Spanish and soon, other languages.</p>
            </div>
           </div>
         </div>
      </div><!-- parallax -->

      <div id="contact">
        <div class="social">
          <a href="http://twitter.com/voyzes" title="Twitter" class="twitter"><i class="fa fa-twitter"></i></a>
          <a href="http://facebook.com/voyzes" class="facebook"><i class="fa fa-facebook-official"></i></a>
          <a href="http://linkedin.com/voyzes" class="linked-in"><i class="fa fa-linkedin-square"></i></a>
          <div class="clear"></div>
        </div><!-- .social -->

        <p>If you have any feedback or suggestions</p>

        <div class="form">
          <form action="" method="post" enctype="multipart/form-data">
            <input type="text" name="name" placeholder="Name*">
            <br><br>

            <input type="text" name="email" placeholder="Email*">
            <br><br>

            <textarea name="your_message" placeholder="Your message*"></textarea>
            <br><br>

            <input class="button" type="submit" value="Send" />
          </form>
        </div><!-- .form -->

        <div class="button button-with-chrome button-contact-us">Contact us</div>
      </div><!-- #contact -->

      <footer>
        <div class="wrapper">
          <div class="left">
            <h5><a class="logo" href="/">VOYZ.ES</a></h5>
            <a href="/help">Help</a>
            <a href="/careers">Careers</a>
            <a href="/blog">Blog</a>
            <a href="/newsroom">Newsroom</a>
          </div><!-- .left -->
          <div class="right">
            <span class="copy">All rights reserved · VOYZES, Inc.</span>
            <a id="footer-privacy" href="/terms/privacy-policy">Privacy</a><a href="/terms/terms-of-service">Terms of Service</a>
          </div><!-- .right -->
        </div><!-- .wrapper -->
      </footer>
    </div><!-- #content -->
    <%= javascript_include_tag "diecisiete" %>
    <%= yield :javascript_includes %>
    <div id="fb-root"></div>


    <div id="cookie-law-bar">
      <div class="inner-wrapper">
        <p>We use cookies to ensure that we give you the best experience on our website. If you continue to use this site we will assume that you are happy with it.</p>
        <div class="button button-with-chrome button-cookie-law-bar">OK</div>
        <div class="clear"></div>
      </div><!-- .inner-wrapper -->
    </div><!-- #cookie-law-bar -->
  </body>
</html>

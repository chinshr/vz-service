        </div><!-- end row -->
      </div><!-- end container -->
    </div><!-- end intro strip -->

    <div id="home">
      <div class="container">
        <div class="row">
          <div class="col-lg-7 col-md-7 col-sm-7 col-xs-12 text">
            <h2>A tool to record, organize and find everyday conversations</h2>
            <ul>
              <li><b>Easily record, transcribe and organize your voice:</b> conversations, interviews, office meetings, focus groups or classes.</li>
              <li><strong>Store</strong> your audio content privately or publicly in a secure system.</li>
              <li><strong>Edit and improve your transcriptions</strong> directly or through crowdsourcing.</li>
              <li><strong>Share and discover</strong> voices from around the world.</li>
            </ul>
            <%#
            <p><strong>Full responsive design, css3 animationsfully customisable</strong></p>
            <p class="btn-wrp"><a class="c2a-button">Call to action</a></p>
            %>
          </div>

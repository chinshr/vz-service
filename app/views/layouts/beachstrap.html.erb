            <img src="/assets/beachstrap/ipadShot.jpg" class="img-responsive" alt="ipadShot" />
          </div>

        </div><!-- end row -->
      </div><!-- end container -->
    </div><!-- end home -->

  <!-- ======================= CAROUSEL ========================= -->

    <div id="work">
      <div id="myCarousel" class="carousel slide">
        <div class="container">
          <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
              <!-- Indicators -->
              <ol class="carousel-indicators">
                <%#
                <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                <li data-target="#myCarousel" data-slide-to="1"></li>
                <li data-target="#myCarousel" data-slide-to="2"></li>
                %>
              </ol>

              <div class="carousel-inner">

                <!-- carousel item -->
                <div class="item active">
                  <!-- edit contents here -->
                  <div class="container">
                    <h1>What we do.</h1>
                    <div class="caption">
                      <p>Voyzes provides ways to upload, store audios, reliably transcribe them into text and derive meaning from the content to make audio conversations indexable. Anyone will easily record, store, organize and archive audio recordings. Discover unheard voices from around the world.</p>
                      <p>Interviews, meetings, focus groups, classes, customer service; these are every days testimonials that usually remain only in the memory of the people who witness them. With Voyzes, many good stories are going to be found in someones raw conversations; many working misunderstandings will be solved by recording office meetings and some countries will improve their access to information and transparency with more sources available.</p>
                    </div>
                  </div>
                
                  <div class="container">
                    <div class="row placeholders">
                      <div class="col-lg-3 col-md-3 col-sm-3 placeholder">
                        <button class="btn btn-default btn-circle">
                          <i class="glyphicon glyphicon-phone"></i>
                        </button>
                        <h4>Record</h4>
                      </div>
                      <div class="col-lg-3 col-md-3 col-sm-3 placeholder">
                        <button class="btn btn-default btn-circle">
                          <i class="glyphicon glyphicon-edit"></i>
                        </button>
                        <h4>Edit</h4>
                      </div>
                      <div class="col-lg-3 col-md-3 col-sm-3 placeholder">
                        <button class="btn btn-default btn-circle">
                          <i class="glyphicon glyphicon-comment"></i>
                        </button>
                        <h4>Share</h4>
                      </div>
                      <div class="col-lg-3 col-md-3 col-sm-3 placeholder">
                        <button class="btn btn-default btn-circle">
                          <i class="glyphicon glyphicon-globe"></i>
                        </button>
                        <h4>Discover</h4>
                      </div>
                    </div><!-- end row -->
                  </div><!-- end container -->
                  <%#
                  <img src="/assets/beachstrap/responsiveShot.png" alt="responsiveShot" class="img-responsive" >
                  <p class="btn-wrp"><a class="c2a-button">Call to action</a></p>
                  %>
                  <!-- stop editing here -->
                </div>
                <!-- end item -->
              
                <%#
                <!-- carousel item -->
                <div class="item">
                  <!-- edit contents here -->
                  <div class="container">
                    <h1>Example headline.</h1>
                    <div class="caption">
                      <p>Cras justo odio, dapibus ac facilisis in, egestas eget quam. Donec id elit non mi porta gravida at eget metus. Nullam id dolor id nibh ultricies vehicula ut id elit.</p>
                    </div>
                  </div>
                  <img src="/assets/beachstrap/responsiveShot.png" alt="responsiveShot" class="img-responsive" >
                  <p class="btn-wrp"><a class="c2a-button">Call to action</a></p>
                  <!-- stop editing here -->

<div id="publish-popover-publishing-page">
  <div class="popover-heading">
    <p>How do you want to publish your changes?</p>
  </div>
  <div class="popover-body">
    <ul class="privacy-options">
      <li><button class="btn btn-link btn-options btn-privacy" data-target="privacy-page">Visibility: <i class="btn-privacy-selection"><%= @privacy %></i></button></li>
      <% if false: %>
      <li><button class="btn btn-link btn-options btn-license" data-target="show-license-popover">License: All rights reserved</button></li>
      <% end %>
    </ul>
  </div><!-- .popover-body -->
  <div class="popover-footer">
    <button class="btn btn-lg btn-success btn-publish btn-publish-document" type="submit" id="btn-publish-document" data-loading-text="Publishing...">Publish Changes</button>
  </div>
</div><!-- #publish-popover-publishing-page -->

<div style="display:none;" id="privacy-page">
  <form class="xform-horizontal" role="form" disabled="true">
    <div class="popover-heading">
      <p>Publishing visibility?</p>
      <div class="form-group form-group-privacy clearfix">
        <div class="btn-group group-privacy pull-left" data-toggle="buttons">
          <label class="btn btn-primary btn-sm btn-radio active">
            <input type="radio" name="document[privacy]" id="document-privacy-public" value="public" checked="" data-title="Public" data-title-can-view="Public, can view" data-title-can-edit="Public, can edit" data-description="The document will be public on the Web. Anyone can edit, but only you can publish it." data-description-can-view="The document will be public on the Web. Anyone can view, but only you can edit and publish it." data-description-can-edit="The document will be public on the Web. Anyone can edit and view, but only you can publish it."><i class="fa fa-unlock icon-public"></i>&nbsp;Public
          </label>
          <label class="btn btn-primary btn-sm btn-radio">
            <input type="radio" name="document[privacy]" id="document-privacy-unlisted" value="unlisted" checked="" data-title="Limited" data-title-can-view="Limited, can view" data-title-can-edit="Limited, can edit" data-description="The document will only be visible to those with the link. Only you can edit and publish the document." data-description-can-view="The document will only be visible to those with the link. Only you can edit and publish it." data-description-can-edit="The document will only be visible and editable to those with the link. Only you can publish it."><i class="fa fa-eye-slash icon-unlisted"></i>&nbsp;Limited
          </label>
          <label class="btn btn-primary btn-sm btn-radio">
            <input type="radio" name="document[privacy]" id="document-privacy-private" value="private" data-title="Private" data-description="The document will be private and not be published. Only you can edit and view the document."><i class="fa fa-lock icon-private"></i>&nbsp;Private
          </label>
        </div><!-- .btn-group .group-file-privacy -->
      </div><!-- .form-group .from-group-file-privacy -->
      <div class="form-group form-group-document-accessibility">
        <label class="xhidden" for="disabledSelect">Anyone</label>
        <select data-placeholder="can..." name="document[accessibility]" id="document-accessibility" class="xform-control input-sm input-accessibility">
          <option value="view" <%= 'selected' if @accessibility.indexOf('view') >= 0 %>>can view</option>
          <option value="edit" <%= 'selected' if @accessibility.indexOf('edit') >= 0 %>>can edit</option>
        </select>
      </div><!-- .form-group-document-accessibility -->
    </div>

    <div class="popover-body">
      <p id="privacy-help-description" class="privacy-help">The document will be public. Your followers will be notified when you publish for the first time.</p>
    </div><!-- .popover-body -->

    <div class="popover-footer">
      <button class="btn btn-md btn-success btn-submit" type="submit" data-loading-text="Updating...">Update</button>
      <button class="btn btn-md btn-link btn-cancel" type="button">Cancel</button>
    </div><!-- .popover-footer -->
  </form>
</div><!-- #publish-popover-privacy-page -->
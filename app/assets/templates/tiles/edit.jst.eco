<div class="tile edit-tile">
  <p class="number"><%= @id || 0 %></p>
  <div class="flipper">
    <div class="panel edit-panel">
      <a href="#" class="media-image media-image-thumb">
        <!-- progress -->
        <div class="progress <% if @progress && @progress < 100: %> progress-striped <% end %>  active" hidden>
          <div class="progress-bar progress-bar-success" style="width: <%= @progress %>%"></div>
        </div>
        <span class="thumb thumb-video thumb-crop-top thumb-upload image">

          <!-- image -->
          <span class="thumb-sizer">
            <span class="thumb-tugger">
              <img src="<%= @thumb_aspect_ratio_1_url %>" style="background-color: <%= @thumb_bg_color %>" class="thumb-image thumb-image-square" />
              <span class="thumb-aligner"></span>
            </span>
          </span>

          <!-- status -->
          <span class="upload-status running" hidden></span>

          <!-- close -->
          <button type="button" aria-hidden="true" class="btn-close btn-thumb action-close"><i class="fa fa-close"></i></button>

          <!-- privacy -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-privacy btn-thumb">
          </button>

          <!-- share -->
          <button type="button" hidden aria-hidden="true" data-toggle="popover" class="btn-share btn-thumb">
            <i class="fa fa-share"></i>
          </button>

          <!-- loading -->
          <div class="loading xspinner"></div>

        </span>  <!-- thumb -->
      </a>  <!-- .media-image -->

      <!-- upload image input -->
      <input class="image-upload" type="file" name="files[]" />

      <form role="form" disabled="true">
        <div class="panel-body">
          <div class="form-fields">

            <div class="form-group form-group-title">
              <label class="sr-only" for="">Title</label>
              <input type="text" class="form-control input-sm" placeholder="Title" name="upload[title]" value="<%= @title %>" data-error-style="tooltipx" data-tooltip-position="bottom"></input>
            </div><!-- form-group-title -->

            <div class="form-group form-group-tags">
              <label class="sr-only" for="">Tags</label>
              <input type="text" class="form-control input-sm input-taggable" placeholder="Tags" name="upload[tag_list]" value="<%= (@tags || []).join(',') %>" data-error-style="tooltip" data-tooltip-position="right"></input>
            </div><!-- form-group-tags -->

            <div class="form-group form-group-description">
              <label class="sr-only" for="">Description</label>
              <textarea class="form-control input-sm" placeholder="Description" rows="4" name="upload[description]"><%= @description %></textarea>
            </div><!-- form-group-description -->

            <div class="form-group form-group-audio-language">
              <label class="sr-only" for="">Audio Language</label>
              <select class="form-control input-sm file-locale input-single-searchable" name="upload[locale]" value="<%= @locale %>">
                <option value="en-US"<%= if @locale == "en-US": %> selected="selected"<% end %>>English United States</option>
                <option value="es-ES" <%= if @locale == "es-ES": %> selected="selected"<% end %>>Spanish International</option>
<!--
                <option value="en-UK" disabled <%= if @locale == "en-UK": %> selected="selected"<% end %>>English Great Britain</option>
                <option value="de-DE" disabled <%= if @locale == "de-DE": %> selected="selected" <% end %>>German Germany</option>
                <option value="fr-FR" disabled <%= if @locale == "fr-FR": %> selected="selected"<% end %>>French France</option>
                <option value="it-IT" disabled <%= if @locale == "it-IT": %> selected="selected"<% end %>>Italian Italy</option>
                <option value="es-MX" disabled <%= if @locale == "es-MX": %> selected="selected"<% end %>>Spanish Mexico</option>
                <option value="es-AR" disabled <%= if @locale == "es-AR": %> selected="selected"<% end %>>Spanish Argentina</option>
                <option value="es-VE" disabled <%= if @locale == "es-VE": %> selected="selected"<% end %>>Spanish Venezuela</option>
-->
              </select>
            </div><!-- form-group-audio-language -->

          </div><!-- form-fields -->
        </div><!-- panel-body -->
        <div class="panel-footer">
          <div class="form-group from-group-file-privacy clearfix">
            <button class="btn btn-sm btn-primary pull-right" type="submit" disabled data-loading-text="Updating...">Update</button>
            <button class="btn btn-sm btn-default action-close pull-right">Cancel</button>
          </div><!-- .from-group-file-privacy -->
        </div><!-- .panel-footer -->
      </form>
    </div><!-- .edit-panel -->
  </div><!-- .flipper -->
</div><!-- .edit-tile -->

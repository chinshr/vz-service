<div class="tile show-tile">
  <p class="number"><%= @id || 0 %></p>
  <div class="flipper">
    <div class="panel show-panel">
      <a href="#" class="media-image media-image-thumb">
        <% if @className == "Upload": %>
        <!-- progress -->
        <div class="progress <% if @progress && @progress < 100: %> progress-striped <% end %>  active" hidden>
          <div class="progress-bar progress-bar-success" style="width: <%= @progress %>%"></div>
        </div>
        <% end %>
        <span class="thumb thumb-video thumb-crop-top thumb-play-pause xplay xsticky">
          <!-- image -->
          <span class="thumb-sizer">
            <span class="thumb-tugger">
              <img src="<%= @thumb_aspect_ratio_1_url %>" style="background-color: <%= @thumb_bg_color %>" class="thumb-image thumb-image-square" />
              <span class="thumb-aligner"></span>
            </span>
          </span>

          <% if @className == "Upload": %>
          <!-- status -->
          <span class="upload-status running"></span>

          <!-- more... -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-more btn-thumb action-more" hidden>
            <i class="fa fa-ellipsis-h"></i>
          </button>

          <!-- privacy -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-privacy private btn-thumb" hidden>
          </button>
          <% end %>

          <!-- share -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-share btn-thumb">
            <i class="fa fa-share"></i>
          </button>

          <!-- loading -->
          <div class="loading xspinner"></div>

          <!-- scrolling animations -->
          <div class="animated-container">
            <!--
            <p class="animated-description scroll-up"><%= @description %></p>
            -->
            <div class="animated-segments">
              <div class="animated-segments-content xstart">
                <!-- this is where the content goes -->
              </div><!-- .animated-segments-content -->
            </div><!-- .animated-titles -->
          </div><!-- .animated-container -->
        </span>  <!-- thumb -->
      </a>  <!-- .media-image -->

      <div class="panel-heading">
        <h3 class="document-title">
          <a href="#" class="document-title-link edit-slug published-slug"><%= @title || @file_name %></a>
        </h3>
        <span class="slug edit-slug published-slug" hidden><i class="fa fa-link"><a href="#" target="_blank">http://foo.bar</a></i></span>
      </div><!-- .panel-heading -->

      <div class="panel-body">
        <div class="tags-title">Tagged in</div>
        <ul class="tag-list">
          <% if @tags.length == 0: %>
          <li class="empty-tag">Add optional tags.</li>
          <% else: %>
            <% for tag in @tags: %>
            <li class="tag" data-tag-slug="<%= tag.slug %>"><a href="<%= '/explore/tag/' + tag.slug + '?source=tile' %>"><%= tag.name %></a></li>
            <% end %>
          <% end %>
        </ul>
      </div><!-- .panel-body -->

    </div><!-- .panel -->
  </div><!-- .flipper -->
</div><!-- show-tile -->

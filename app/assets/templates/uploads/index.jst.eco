<div class="well">
  <div id="drop-box" style="font-size: 28px; height: 200px; line-height: 200px; margin: 0 auto; text-align: center;">
    Drop audio files here...
  </div>
  <form role="form">
    <fieldset>
      <div id="files-picker" class="form-group">
        <input type="file" id="files" name="files[]" multiple />
      </div>
      <div class="form-group">
        <label for="disabledSelect">Audio language</label>
        <select id="file-locale" class="form-control">
          <option value="en-US">English United States</option>
          <option value="en-UK">English Great Britain</option>
          <option value="es-ES">Spanish Spain</option>
          <option value="es-MX">Spanish Mexico</option>
          <option value="es-AR">Spanish Argentina</option>
          <option value="es-VE">Spanish Venezuela</option>
        </select>
      </div>
      <div class="form-group">
        <label for="disabledSelect">Privacy</label>
        <select id="file-privacy" class="form-control">
          <option value="public">Public</option>
          <option value="private">Private</option>
          <option value="unlisted">Unlisted</option>
        </select>
      </div>
    </fieldset>
  </form>
</div>

<div id="file-uploads">
</div>
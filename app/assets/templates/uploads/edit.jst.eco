<!-- div class="tile edit-tile col-lg-4 col-md-4 col-sm-4" -->
  <div class="flipper">
    <div class="panel edit-panel">
      <form role="form" disabled="true">
        <div class="progress progress-striped active">
          <div class="progress-bar progress-bar-info" style="width: <%= @progress %>%"></div>
        </div>
        <div class="panel-heading">
          <button type="button" class="close action-close">×</button>
          <h3><i class="fa icon-privacy <%= if @privacy == 'private': %> fa-lock icon-private <% else: %> fa-unlock icon-public <% end %> "></i><%= @title || @file_name %></h3>

          <span class="label label-info label-status"><span class="message"><%= @message %></span></span>
          <span class="slug" hidden><i class="fa fa-link"><a href="YdG3bj" target="_blank">http://localhost:3000/YdG3bj</a></i></span>
        </div><!-- panel-heading -->
        <div class="panel-body">
          <div class="form-fields">

            <div class="form-group form-group-title">
              <label class="sr-only" for="">Title</label>
              <input type="text" class="form-control input-sm" placeholder="Title" name="upload[title]" value="<%= @title %>" data-error-style="tooltipx" data-tooltip-position="bottom"></input>
            </div><!-- form-group-title -->

            <div class="form-group form-group-tags">
              <label class="sr-only" for="">Tags</label>
              <input type="text" class="form-control input-sm input-taggable" placeholder="Tags" name="upload[tag_list]" value="<%= (@tag_list || []).join(',') %>" data-error-style="tooltip" data-tooltip-position="right"></input>
            </div><!-- form-group-tags -->

            <div class="form-group form-group-description">
              <label class="sr-only" for="">Description</label>
              <textarea class="form-control input-sm" placeholder="Description" name="upload[description]"><%= @description %></textarea>
            </div><!-- form-group-description -->

            <div class="form-group form-group-audio-language">
              <label class="sr-only" for="">Audio Language</label>
              <select class="form-control input-sm file-locale input-single-searchable" name="upload[locale]" value="<%= @locale %>">
                <option value="en-US"<%= if @locale == "en-US": %> selected="selected"<% end %>>English United States</option>
                <option value="es-ES" <%= if @locale == "es-ES": %> selected="selected"<% end %>>Spanish</option>
<!--
                <option value="en-UK" disabled <%= if @locale == "en-UK": %> selected="selected"<% end %>>English Great Britain</option>
                <option value="de-DE" disabled <%= if @locale == "de-DE": %> selected="selected" <% end %>>German Germany</option>
                <option value="fr-FR" disabled <%= if @locale == "fr-FR": %> selected="selected"<% end %>>French France</option>
                <option value="it-IT" disabled <%= if @locale == "it-IT": %> selected="selected"<% end %>>Italian Italy</option>
                <option value="es-MX" disabled <%= if @locale == "es-MX": %> selected="selected"<% end %>>Spanish Mexico</option>
                <option value="es-AR" disabled <%= if @locale == "es-AR": %> selected="selected"<% end %>>Spanish Argentina</option>
                <option value="es-VE" disabled <%= if @locale == "es-VE": %> selected="selected"<% end %>>Spanish Venezuela</option>
-->
              </select>
            </div><!-- form-group-audio-language -->

          </div><!-- form-fields -->
        </div><!-- panel-body -->
        <div class="panel-footer">
          <div class="form-group from-group-file-privacy clearfix">
            <button class="btn btn-sm btn-success pull-right" type="submit" disabled data-loading-text="Updating...">Update</button>
            <button class="btn btn-sm btn-link action-close pull-right">Cancel</button>
          </div><!-- .from-group-file-privacy -->
        </div><!-- .panel-footer -->
      </form>
    </div><!-- .edit-panel -->
  </div><!-- .flipper -->
<!-- /div --><!-- .edit-tile -->
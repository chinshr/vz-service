<div class="progress-panel well">
  <button type="button" class="close cancel" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">×</button>
  <h4><%= @file_name %>&nbsp;
    <span class="label label-info status"><span class="message">Initializing.</span></span>
  </h4>
  <form class="form-horizontal" role="form" disabled="true">
    <div class="progress progress-striped active">
      <div class="progress-bar progress-bar-info" style="width: 0%"></div>
    </div>

    <div class="alert alert-success alert-slug">
      <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
      <div class="alert-slug-message">Transcribe availabe at&nbsp;<span class="alert-slug-link"><a href="YdG3bj" target="_blank">http://localhost:3000/YdG3bj</a></span></div>
    </div>

    <div class="form-fields" style="display:none">
      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <div class="col-md-12">
              <input type="text" class="form-control" placeholder="Title" name="upload[title]" value="<%= @title %>"></input>
            </div>
          </div>

          <div class="form-group">
            <div class="col-md-12">
              <textarea class="form-control" placeholder="Description" name="upload[description]" value="<%= @description %>"></textarea>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="form-group">
            <div class="col-md-12">
              <select class="form-control file-locale" name="upload[locale]">
                <option value="en-US">English United States</option>
                <option value="en-UK">English Great Britain</option>
                <option value="es-ES">Spanish Spain</option>
                <option value="es-MX">Spanish Mexico</option>
                <option value="es-AR">Spanish Argentina</option>
                <option value="es-VE">Spanish Venezuela</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <div class="col-md-12">
              <select class="form-control file-privacy" name="upload[privacy]">
                <option value="public">Public</option>
                <option value="private">Private</option>
                <option value="unlisted">Unlisted</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-12">
          <button class="btn btn-success pull-right" type="button" disabled="true">Update</button>
        </div>
      </div>
    </div>

  </form>
</div>

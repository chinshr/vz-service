<div class="progress-panel well">
  <button type="button" class="close cancel" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">×</button>
  <h4><span class="message">Initializing.</span>&nbsp;'<%= @name %>'</h4>
  <form class="form-horizontal" role="form" disabled="true">
    <div class="progress progress-striped active">
      <div class="progress-bar progress-bar-info" style="width: 0%"></div>
    </div>

    <div class="" style="xdisplay:none">
      <div class="form-group">
        <div class="col-sm-12">
          <input type="text" class="form-control" placeholder="Name" name="uploads[name]" value="<%= @name %>"></input>
        </div>
      </div>

<!--
      <div class="form-group">
        <div class="col-sm-12">
          <textarea class="form-control" placeholder="Update description" name="uploads[description]" disabled="true"></textarea>
        </div>
      </div>
-->

      <div class="form-group">
        <div class="col-sm-12">
          <button class="btn btn-success pull-right" type="button" disabled="true">Update</button>
        </div>
      </div>
    </div>

  </form>
</div>

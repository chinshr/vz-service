<!-- Upload Source Modal -->
<div class="modal fade" id="upload-source-modal" tabindex="-1" role="dialog" aria-labelledby="upload-source-modal-label" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form role="form" disabled="false">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span>
            <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="upload-source-modal-label">
            Source Upload
          </h4>
        </div>
        <!-- Modal Body -->
        <div class="modal-body">
          <div class="form-group">
            <label for="input-source-url">Source URL</label>
            <input type="url" class="form-control" id="input-source-url" placeholder="Enter media link" name="upload[source_url]" value="<%= @source_url %>" data-error-style="xinline" data-tooltip-position="bottom"/>
          </div>

          <div class="help-block">We accept media files to be uploaded from Web locations including Cloud services, like <a href="#">Dropbox</a>, <a href="#">Google Drive</a> and <a href="#">many others</a>.</div>

          <div class="form-group form-group-locale">

            <label for="file-locale">Language</label>
            <select data-placeholder="Choose a Language..." id="file-locale" name="upload[locale]" class="form-control input-sm input-single-searchable">
              <option value="en-US">English United States</option>
              <option value="es-ES">Spanish</option>
  <!--
              <option value="en-UK" disabled>English Great Britain</option>
              <option value="de-DE" disabled>German Germany</option>
              <option value="fr-FR" disabled>French France</option>
              <option value="it-IT" disabled>Italian Italy</option>
              <option value="es-MX" disabled>Spanish Mexico</option>
              <option value="es-AR" disabled>Spanish Argentina</option>
              <option value="es-VE" disabled>Spanish Venezuela</option>
  -->
            </select>
          </div><!-- .form-group-locale -->

          <div class="checkbox">
            <label>
              <input type="hidden" name="upload[use_source_annotations]" value="<%= @use_source_annotations %>" />
              <input type="checkbox" name="upload[use_source_annotations]" value="1" /> Use annotations if available
            </label>
          </div>
        </div>
        <!-- Modal Footer -->
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" data-loading-text="Uploading...">Upload</button>
        </div>
      </form>
    </div>
  </div>
</div><!-- #upload-source-modal -->

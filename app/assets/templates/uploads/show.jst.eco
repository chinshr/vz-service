<div class="tile show-tile">
  <p class="number"><%= @id || 0 %></p>
  <div class="flipper">
    <div class="panel show-panel">
      <a href="#" class="media-image media-image-thumb">
        <!-- progress -->
        <div class="progress <% if @progress && @progress < 100: %> progress-striped <% end %>  active">
          <div class="progress-bar progress-bar-success" style="width: <%= @progress %>%"></div>
        </div>

        <span class="thumb thumb-video thumb-crop-top thumb-play xplay">
          <!-- image -->
          <span class="thumb-sizer">
            <span class="thumb-tugger">
              <img src="<%= @thumb_aspect_ratio_1_url %>" style="background-color: <%= @thumb_bg_color %>" class="thumb-image thumb-image-square" />
              <span class="thumb-aligner"></span>
            </span>
          </span>

          <!-- status -->
          <span class="upload-status running">Processing</span>

          <!-- more... -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-more btn-thumb action-more">
            <i class="fa fa-ellipsis-h"></i>
          </button>

          <!-- privacy -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-privacy private btn-thumb">
          </button>

          <!-- share -->
          <button type="button" aria-hidden="true" data-toggle="popover" class="btn-share btn-thumb">
            <i class="fa fa-share"></i>
          </button>

          <!-- loading -->
          <div class="loading xspinner"></div>

        </span>  <!-- thumb -->
      </a>  <!-- .media-image -->

      <div class="panel-heading">
        <h3 class="document-title">
          <a href="#" class="document-title-link edit-slug"><%= @title || @file_name %></a>
        </h3>
        <span class="slug edit-slug" hidden><i class="fa fa-link"><a href="#" target="_blank">http://foo.bar</a></i></span>
      </div><!-- .panel-heading -->

      <div class="panel-body">
        <div class="tags-title">Tagged in</div>
        <ul class="tag-list">
          <% if @tag_list.length == 0: %>
          <li class="empty-tag">Add up to 3 optional tags.</li>
          <% else: %>
            <% for tag in @tag_list: %>
            <li class="tag"><a href="#"><%= tag %></a></li>
            <% end %>
          <% end %>
        </ul>
      </div><!-- .panel-body -->

    </div><!-- .panel -->
  </div><!-- .flipper -->
</div><!-- show-tile -->

<!--div class="tile show-tile col-lg-4 col-md-4 col-sm-4" -->
  <div class="flipper">
    <div class="panel show-panel">
      <div class="progress <%= if @progress && @progress < 100: %> progress-striped <% end %> active">
        <div class="progress-bar progress-bar-success" style="width: <%= @progress %>%"></div>
      </div>
      <div class="panel-heading">

        <div class="dropdown">
          <button type="button" aria-hidden="true" data-toggle="dropdown" class="cog btn-dropdown-toggle"><i class="glyphicon glyphicon-cog"></i></button>
          <ul class="dropdown-menu dropdown-menu-right" role="menu" xaria-labelledby="settings-button">
            <li role="presentation"><a class="action-update" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-wrench"></i>Settings</a></li>
            <li role="presentation" class="disabled"><a class="action-edit" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-pencil"></i>Edit</a></li>
            <li role="presentation" class="disabled"><a class="action-preview" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-eye-open"></i>Preview</a></li>
            <li role="presentation" class="divider"></li>
            <!--
            <li role="presentation"><a class="action-collaborate" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-plus"></i>Add collaborator</a></li>
            <li role="presentation"><a class="action-plan" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-credit-card"></i>Change plan</a></li>
            <li role="presentation" class="divider"></li>
            -->
            <li role="presentation" class="<%= 'disabled' unless _.contains(@events, 'stop') || _.contains(@events, 'stop_upload') %>"><a class="action-stop" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-stop"></i>Stop</a></li>
            <li role="presentation" class="<%= 'disabled' unless _.contains(@events, 'start') %>"><a class="action-start" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-play"></i>Start</a></li>
            <li role="presentation"><a class="action-delete" role="menuitem" tabindex="-1" href="#"><i class="glyphicon glyphicon-trash"></i>Archive</a></li>
          </ul>
        </div><!-- dropdown -->

        <h3><i class="fa icon-privacy <%= if @privacy == 'private': %> fa-lock icon-private <% else: %> fa-unlock icon-public <% end %>"></i><%= @title || @file_name %></h3>
        <span class="label label-success label-status"><span class="message"><%= @message %></span></span>
        <span class="slug" hidden><i class="fa fa-link"><a href="#" target="_blank">http://foo.bar</a></i></span>
      </div><!-- .panel-heading -->
      <div class="panel-body">
        <div class="tags-title">Tagged in</div>
        <ul class="tag-list">
          <% if @tag_list.length == 0: %>
          <li class="empty-tag">Add up to 3 optional tags.</li>
          <% else: %>
            <% for tag in @tag_list: %>
            <li class="tag"><a href="#"><%= tag %></a></li>
            <% end %>
          <% end %>
        </ul>
      </div><!-- .panel-body -->
      <div class="panel-background">
        <div class="action-panel">
          <div class="action-panel-bg-holder img">
            <div class="img"></div>
            <!-- <img src="/assets/bg/waveform-icon-white.png" /> -->
          </div>
          <div class="action-panel-btn-group">
            <button class="btn btn-primary btn-lg btn-panel-action action-update"><i class="glyphicon glyphicon-wrench"></i>&nbsp;Settings</button>
            <button disabled class="btn btn-primary btn-lg btn-panel-action action-edit"><i class="glyphicon glyphicon-pencil"></i>&nbsp;Edit</button>
            <button disabled class="btn btn-primary btn-lg btn-panel-action action-preview"><i class="glyphicon glyphicon-eye-open"></i>&nbsp;Preview</button>
          </div><!-- .action-panel-btn-group -->
        </div><!-- .action-panel-->
        <div class="description-holder">
          <p><%= @description %></p>
        </div><!-- .description-holder -->
      </div><!-- .panel-background -->
    </div><!-- .panel -->
  </div><!-- .flipper -->
<!-- /div --><!-- .show-tile -->
